{
    "name": "isotope/isotope-core",
    "description": "Isotope is the premier open source eCommerce solution for Contao Open Source CMS",
    "homepage": "https://isotopeecommerce.org",
    "keywords": ["contao", "isotope"],
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "terminal42 gmbh",
            "homepage": "https://www.terminal42.ch"
        }
    ],
    "funding": [
        {
            "type": "other",
            "url": "https://circle.isotopeecommerce.org"
        },
        {
            "type": "github",
            "url": "https://github.com/terminal42"
        },
        {
            "type": "other",
            "url": "https://ko-fi.com/terminal42"
        }
    ],
    "support": {
        "issues": "https://github.com/isotope/core/issues",
        "source": "https://github.com/isotope/core",
        "forum": "https://community.contao.org/de/forumdisplay.php?111-isotope",
        "docs": "https://docs.isotopeecommerce.org/"
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "composer-runtime-api": "^2",
        "contao/core-bundle": "^5.7.4",
        "codefog/contao-haste": "^5.4",
        "hashids/hashids": "^4.1",
        "ramsey/collection": "^2.0",
        "terminal42/contao-conditionalselectmenu": "^4.1",
        "terminal42/dc_multilingual": "^4.7",
        "terminal42/dcawizard": "^3.1",
        "terminal42/notification_center": "^2.7",

        "ausi/slug-generator": "^1.1",
        "doctrine/dbal": "^4.3",
        "knplabs/knp-menu": "^3.1",
        "monolog/monolog": "^3.5",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || 2.0 || ^3.0",
        "symfony/asset": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/deprecation-contracts": "^3.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/filesystem": "^7.4",
        "symfony/http-client-contracts": "^3.1",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/polyfill-php84": "^1.0",
        "symfony/polyfill-php85": "^1.0",
        "symfony/property-access": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/service-contracts": "^3.2",
        "symfony/string": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/translation-contracts": "^3.0",
        "symfony/uid": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/workflow": "^7.4",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "terminal42/contao-build-tools": "dev-main",
        "contao/test-case": "5.7.*",
        "doctrine/doctrine-bundle": "^2.15",
        "knplabs/knp-menu-bundle": "^3.0",
        "phpunit/phpunit": "^12.4",
        "scheb/2fa-bundle": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/monolog-bundle": "^3.1",
        "symfony/twig-bundle": "^7.4"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >= 3.0",
        "isotope/isotope_documents": "*"
    },
    "autoload": {
        "psr-4": {
            "Isotope\\CoreBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Isotope\\CoreBundle\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "terminal42/contao-build-tools": true,
            "contao/manager-plugin": false,
            "contao-community-alliance/composer-plugin": false,
            "contao-components/installer": false,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "unit-tests": "@php vendor/bin/phpunit"
    },
    "extra": {
        "contao-manager-plugin": "Isotope\\CoreBundle\\ContaoManager\\Plugin"
    }
}
