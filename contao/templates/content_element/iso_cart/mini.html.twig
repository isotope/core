{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/iso_cart.html.twig' %}
{% use '@Contao/isotope/product_collection/mini.html.twig' %}

{% block product_collection_actions %}
    <div class="cart">{{ isotope_product_collection_action('go_to_cart', { link: true }) }}</div>
    <div class="checkout">{{ isotope_product_collection_action('go_to_checkout', { link: true }) }}</div>
{% endblock %}

{% block product_collection_item_actions %}
    {{ isotope_product_collection_item_action('remove_from_cart') }}
{% endblock %}
