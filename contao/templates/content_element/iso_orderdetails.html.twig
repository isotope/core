{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}
{% use '@Contao/isotope/product_collection.html.twig' %}

{% set attributes = attrs()
    .set('data-controller', 'isotope--collection isotope--fragment')
    .set('data-isotope--collection-id-value', fragment_id)
    .set('data-isotope--collection-type-value', 'order')
    .set('data-isotope--fragment-id-value', fragment_id)
    .mergeWith(attributes|default)
%}

{% block content %}

    <h2>{{ 'MSC.orderDetailsHeadline'|trans([collection.documentNumber, collection.locked|date(contao.page.datimFormat)]) }}</h2>
    <div class="transaction_status {{ collection.transactionStatus.alias }}">{{ 'MSC.transactionStatusHeadline'|trans([collection.transactionStatus.label|default(collection.transactionStatus.name)|trans([], 'isotope')]) }}</div>
    <div class="delivery_status {{ collection.deliveryStatus.alias }}">{{ 'MSC.deliveryStatusHeadline'|trans([collection.deliveryStatus.label|default(collection.deliveryStatus.name)|trans([], 'isotope')]) }}</div>

    {% if payment_pending %}
        <form id="order_payment" method="post" data-action="isotope--fragment#submit">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
        </form>

        <div class="payment_failed">
            <p class="message">{{ 'MSC.payment_failed'|trans }}</p>
            <button type="submit" class="change_payment" form="order_payment" name="change_payment" value="1">{{ 'MSC.payment_change'|trans }}</button>
            <a class="submit" href="{{ app.request.uri }}&init_payment=1">{{ 'MSC.payment_complete'|trans }}</a>
        </div>

        {% if change_payment|default %}
            <div class="payment_method">
                <form method="post" data-action="isotope--fragment#submit">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                    <input type="hidden" name="change_payment" value="1">

                    <fieldset class="radio_container">
                        {% for option in payment_options %}
                            <span>
                            <input
                                id="opt_payment_{{ option.value }}"
                                type="radio"
                                name="payment_id"
                                class="radio"
                                value="{{ option.value }}"
                                {% if option.active %} checked{% endif %}
                            >
                            <label for="opt_payment_{{ option.value }}">{{ option.label }}</label>
                        </span>
                        {% endfor %}
                    </fieldset>
                    <button type="submit">Select</button>
                </form>
            </div>
        {% endif %}
    {% endif %}

    <div class="steps">
        {% block steps %}
            {% block billing_address %}
                {% if collection.billingAddress %}
                    <div>
                        {% if collection.shippingMethod and not collection.shippingAddress %}
                            <h3>{{ 'MSC.billing_shipping_address'|trans }}</h3>
                        {% elseif collection.paymentMethod %}
                            <h3>{{ 'MSC.billing_address'|trans }}</h3>
                        {% else %}
                            <h3>{{ 'MSC.customer_address'|trans }}</h3>
                        {% endif %}
                        {{ isotope_address(collection.billingAddress, collection.context.billingAddressConfig) }}
                    </div>
                {% endif %}
            {% endblock %}

            {% block shipping_address %}
                {% if collection.shippingAddress %}
                    <div>
                        <h3>{{ 'MSC.shipping_address'|trans }}</h3>
                        {{ isotope_address(collection.shippingAddress, collection.context.shippingAddressConfig) }}
                    </div>
                {% endif %}
            {% endblock %}

            <div>
                <h3>Information</h3>
                {% if collection.shippingMethod %}
                    <p>
                        <strong>{{ 'MSC.shipping_method'|trans }}</strong>
                        {{ collection.shippingMethod.label }}
                    </p>
                {% endif %}

                {% if collection.paymentMethod %}
                    <p>
                        <strong>{{ 'MSC.payment_method'|trans }}</strong>
                        {{ collection.paymentMethod.label }}
                    </p>
                {% endif %}

                {% block additional_information %}{% endblock %}
            </div>
        {% endblock %}
    </div>

    <div class="summary">
        <h3>{{ 'MSC.order_review'|trans }}</h3>
        {{ block('product_collection') }}
    </div>

{% endblock %}

{% block product_collection_actions %}
    {% if payment_pending %}
        <a href="{{ app.request.uri }}&init_payment=1">{{ 'MSC.payment_complete'|trans }}</a>
        <button type="submit" form="order_payment" name="cancel_payment" value="1">{{ 'MSC.payment_cancel'|trans }}</button>
    {% endif %}

    {{ isotope_product_collection_action('reorder') }}
{% endblock %}
