{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}
{% use '@Contao/isotope/product_collection.html.twig' %}

{% set attributes = attrs()
    .set('data-controller', 'isotope--fragment')
    .set('data-isotope--fragment-id-value', fragment_id)
    .set('data-action', 'isotope--product:submit.add_to_cart@window->isotope--fragment#update isotope--collection:submit.cart@window->isotope--fragment#update')
    .mergeWith(attributes|default)
%}

{% block content %}
    {% if collection.isEmpty %}
        {% block empty_message %}
            <p class="message empty">{{ 'MSC.noItemsInCart'|trans }}</p>
        {% endblock %}
    {% else %}
        {% block checkout_steps %}
            <div class="steps{% if completed %} completed{% endif %}">
                {% set continue = true %}
                {% for key, step in steps|default %}
                    {% block checkout_step %}
                        {% set step_attributes = attrs()
                            .addClass(key)
                            .addClass('complete', continue and step.completed)
                            .addClass('current', continue and not step.completed)
                            .addClass('pending', not continue)
                            .mergeWith(step_attributes|default)
                        %}
                        <div{{ step_attributes }}>
                            {% if step.title %}
                                <h3>{{ loop.index }}. {{ step.title }}</h3>
                            {% endif %}
                            {% if continue %}{{ step }}{% endif %}
                        </div>
                    {% endblock %}
                    {% if not step.completed %}{% set continue = false %}{% endif %}
                {% endfor %}
            </div>
        {% endblock %}

        {% block checkout_summary %}
            <div class="summary">
                <h3>{{ steps|length + 1 }}. {{ 'MSC.order_review'|trans }}</h3>

                {% for markup in pre_summary %}{{ markup }}{% endfor %}

                {{ block('product_collection') }}

                {% for markup in post_summary %}{{ markup }}{% endfor %}

                <form id="place_order" method="POST">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                    <div class="widget widget-submit">
                        <button type="submit" class="submit" name="place_order" value="1"{% if not completed %} disabled{% endif %}>{{ 'MSC.confirmOrder'|trans }}</button>
                    </div>
                </form>
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}
