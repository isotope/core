{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}
{% use '@Contao/isotope/product_collection.html.twig' %}

{% set attributes = attrs()
    .set('data-controller', 'isotope--collection isotope--fragment')
    .set('data-isotope--collection-id-value', fragment_id)
    .set('data-isotope--fragment-id-value', fragment_id)
    .set('data-action', 'isotope--product:submit.add_to_cart@window->isotope--fragment#update isotope--collection:submit.add_to_cart@window->isotope--fragment#update isotope--collection:submit.remove_from_cart@window->isotope--fragment#update isotope--collection:submit->isotope--fragment#update')
    .mergeWith(attributes|default)
%}

{% block content %}
    {% if collection.isEmpty %}
        <p class="message empty">{{ data.iso_emptyMessage|default ? data.iso_noProducts|default : 'MSC.noItemsInCart'|trans }}</p>
    {% else %}
        {% with {editable: true} %}
            {{ block('product_collection') }}
        {% endwith %}
    {% endif %}
{% endblock %}

{% block product_collection_actions %}
    {{ isotope_product_collection_action('update') }}
    {{ isotope_product_collection_action('go_to_cart') }}
    {{ isotope_product_collection_action('go_to_checkout') }}
    {{ isotope_product_collection_action('continue_shopping') }}
{% endblock %}

{% block product_collection_item_actions %}
    {{ isotope_product_collection_item_action('remove_from_cart') }}
{% endblock %}
