{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}

{% set attributes = attrs()
    .set('data-controller', 'isotope--collection isotope--fragment')
    .set('data-isotope--collection-id-value', fragment_id)
    .set('data-isotope--collection-type-value', 'order')
    .set('data-isotope--fragment-id-value', fragment_id)
    .mergeWith(attributes|default)
%}

{% block content %}

    {% if orders is not empty %}
        <table>
            <thead>
            <tr>
                <th class="document_number">{{ 'MSC.iso_order_document_number'|trans }}</th>
                <th class="order_date">{{ 'MSC.iso_order_date'|trans }}</th>
                <th class="order_total">{{ 'MSC.iso_order_total'|trans }}</th>
                <th class="order_status">{{ 'MSC.iso_transaction_status'|trans }}</th>
                <th class="order_status">{{ 'MSC.iso_delivery_status'|trans }}</th>
                <th class="actions">&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for collection in orders %}
                <tr class="{{ collection.orderStatus.alias }}">
                    <td class="document_number">{{ collection.documentNumber }}</td>
                    <td class="order_date">{{ collection.locked|date(contao.page.dateFormat) }}</td>
                    <td class="order_total">{{ isotope_price(collection.total) }}</td>
                    <td class="transaction_status">{% if collection.transactionStatus %}{{ collection.transactionStatus.label|default(collection.transactionStatus.name)|trans([], 'isotope') }}{% endif %}</td>
                    <td class="delivery_status">{% if collection.deliveryStatus %}{{ collection.deliveryStatus.label|default(collection.deliveryStatus.name)|trans([], 'isotope') }}{% endif %}</td>
                    <td class="actions">
                        <form method="post" data-isotope--collection-target="form" data-action="isotope--collection#formAction">
                            <input type="hidden" name="FORM_SUBMIT" value="{{ fragment_id }}">
                            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                            {{ isotope_product_collection_action('details') }}
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="message empty">{{ 'ERR.emptyOrderHistory'|trans }}</p>
    {% endif %}

{% endblock %}
