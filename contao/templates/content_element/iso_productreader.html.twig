{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}

{% block content %}

    {{ isotope_product(product, view) }}

    {% set referer = content_url(app.request.attributes.get('originalPageModel')) %}
    {% if referer %}
        <!-- indexer::stop -->
        <p class="back"><a href="{{ referer }}">{{ 'MSC.goBack'|trans }}</a></p>
        <!-- indexer::continue -->
    {% endif %}

{% endblock %}
