{% block jsonld_product_component %}
    {% if gallery is not defined %}{% set gallery = isotope_gallery(product, 'images') %}{% endif %}
    {% set weight = product.extension('Isotope\\CoreBundle\\Product\\Extension\\ShippingExtension')?.weight %}

    {% set schema_org = {
        '@type': 'Product',
        identifier: "#/schema/products/#{product.id}",
        sku: product.sku,
        gtin: product.get('gtin'),
        name: product.name,
        description: product.get('description')|striptags,
        color: product.get('color'),
        size: product.get('size'),
        width: product.get('width'),
        height: product.get('height'),
        depth: product.get('depth'),
        weight: weight ? "#{weight.amount} #{weight.unit.value}" : null,
        image: gallery.files.0.src ? {
            '@type': 'ImageObject',
            identifier: gallery.files.0.src,
            contentUrl: app.request.schemeAndHttpHost ~ '/' ~ gallery.files.0.src,
        },
        offer: product.getPrice ? {
            price: isotope.context.moneyFormat.format(product.getPrice.unitPrice),
            priceCurrency: isotope.context.currency.code,
        } : null,
        url: content_url(product),
    } %}

    {% if product.isVariant %}
        {% set schema_org = schema_org|merge({
            isVariantOf: "#/schema/products/#{product.productId}",
        }) %}

        {% if product.variantConfiguration is iterable %}
            {% set properties = [] %}
            {% for name, value in product.variantConfiguration %}
                {% if name not in ['color', 'size', 'width', 'height', 'depth'] %}
                    {% set properties = properties|merge([{
                        '@type': 'PropertyValue',
                        name: isotope_attribute_label(name),
                        value: isotope_attribute_value(name, value)|join(', '),
                    }]) %}
                {% endif %}
            {% endfor %}
            {% if properties is not empty %}
                {% set schema_org = schema_org|merge({additionalProperty: properties}) %}
            {% endif %}
        {% endif %}
    {% endif %}

    {% do add_schema_org(schema_org) %}
{% endblock %}

{% block jsonld_product_group_component %}
    {% set schema_org = {
        '@type': 'ProductGroup',
        identifier: "#/schema/products/#{product.id}",
        name: product.name,
        description: product.get('description')|striptags,
        url: content_url(product),
    } %}
    {% do add_schema_org(schema_org) %}
{% endblock %}
