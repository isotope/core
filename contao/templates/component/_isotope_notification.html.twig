{% block notification_component %}
    {% set dialog_id = dialog_id|default("iso-notification-#{random()}") %}
    {% set closable = closable is defined ? closable : true %}
    {% set notification_attributes = attrs()
        .addClass('isotope-notification')
        .set('id', dialog_id)
        .set('data-controller', 'isotope--notification')
        .set('data-isotope--notification-delay-value', dialog_delay|default(5000))
        .set('data-action', 'click->isotope--notification#hide', closable)
        .mergeWith(notification_attributes|default)
    %}
    <div{{ notification_attributes }}>
        <div class="inner"{% if closable %} data-action="click->isotope--notification#stop"{% endif %}>
            {% if closable %}
                {% block notification_close %}<button class="close" data-action="isotope--notification#hide">Close</button>{% endblock %}
            {% endif %}
            {% block notification_content %}<p>{{ message|default }}</p>{% endblock %}
        </div>
    </div>
{% endblock %}
