{% trans_default_domain 'contao_tl_iso_product_collection' %}
{% for log in logs %}
    {% if not loop.first %}<hr>{% endif %}
    <table class="tl_show with-padding with-zebra">
        <tbody>
        {% for entry in log %}
            <tr>
                <td class="tl_label">{{ entry.label }}</td>
                <td>{{ entry.value }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    <div class="tl_info">{{ 'tl_iso_product_collection.noLogData'|trans }}</div>
{% endfor %}
