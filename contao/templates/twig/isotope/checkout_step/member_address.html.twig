{% trans_default_domain 'contao_default' %}
{% extends '@Contao/isotope/checkout_step/_base.html.twig' %}
{% use '@Contao/component/_isotope_address.html.twig' %}

{% set attributes = attrs()
    .addClass('member')
    .mergeWith(attributes|default)
%}

{% block inner %}
    {% if edit_address|default %}
        {% embed '@Contao/isotope/address_manager.html.twig' with edit_address only %}
            {% block form %}
                {% trans_default_domain 'contao_default' %}
                {% if address.id %}
                    <h3>{{ 'MSC.editAddressHeadline'|trans }}</h3>
                {% else %}
                    <h3>{{ 'MSC.createAddressHeadline'|trans }}</h3>
                {% endif %}
                {{ parent() }}
                <form method="POST" data-action="isotope--fragment#submit">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                    <div class="widget widget-submit">
                        <button type="submit" class="submit cancel" name="edit_address_step" value="1">{{ 'MSC.cancelBT'|trans }}</button>
                    </div>
                </form>
            {% endblock %}
        {% endembed %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    <form method="POST" data-action="isotope--fragment#submit" class="billing_address">
        <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
        <fieldset>
            <legend>
                {% if requires_payment %}
                    <h4>{{ 'MSC.billing_address'|trans }}</h4>
                {% else %}
                    <h4>{{ 'MSC.customer_address'|trans }}</h4>
                {% endif %}
            </legend>
            {% if requires_payment %}
                <p>{{ 'MSC.billing_address_message'|trans }}</p>
            {% else %}
                <p>{{ 'MSC.customer_address_message'|trans }}</p>
            {% endif %}

            <fieldset>
                {% embed '@Contao/isotope/address_manager.html.twig' with billing_address_manager|merge({ current: billing_address }) %}
                    {% trans_default_domain 'contao_default' %}
                    {% block address %}
                        {% if not address.isValid %}<p class="message error">{{ 'MSC.address_error'|trans }}</p>{% endif %}
                        <span>
                            <input
                                id="opt_billing_address_{{ address.data.id }}"
                                type="radio"
                                form="{{ form_id }}"
                                name="billing_address_id"
                                class="radio"
                                value="{{ address.data.id }}"
                                required
                                {% if not address.isValid %}
                                    disabled
                                {% elseif (addresses|length == 1 or address.data.id == current.id|default) %}
                                    checked
                                {% endif %}
                            >
                            <label for="opt_billing_address_{{ address.data.id }}">
                                {% with address only %}{{ block('isotope_address_component') }}{% endwith %}
                            </label>
                        </span>
                    {% endblock %}
                {% endembed %}
            </fieldset>
        </fieldset>
    </form>

    {% if requires_shipping and shipping_address_manager|default %}
        <form method="POST" data-action="isotope--fragment#submit" class="shipping_address">
            <fieldset data-controller="isotope--toggle-attribute">
                <legend>
                    <h4>{{ 'MSC.shipping_address'|trans }}</h4>
                </legend>
                <p>{{ 'MSC.shipping_address_guest_message'|trans }}</p>
                <fieldset class="radio_container">
                    <span>
                        <input
                            id="ctrl_add_shipping_address_0"
                            type="radio"
                            form="{{ form_id }}"
                            name="add_shipping_address"
                            class="radio"
                            value=""
                            required
                            data-action="isotope--toggle-attribute#disable"
                            {% if not add_shipping_address %} checked{% endif %}
                        >
                        <label for="ctrl_add_shipping_address_0">
                            {% if requires_payment %}
                                {{ 'MSC.useBillingAddress'|trans }}
                            {% else %}
                                {{ 'MSC.useCustomerAddress'|trans }}
                            {% endif %}
                        </label>
                    </span>
                    <span>
                        <input
                            id="ctrl_add_shipping_address_1"
                            type="radio"
                            form="{{ form_id }}"
                            name="add_shipping_address"
                            class="radio"
                            value="1"
                            required
                            data-action="isotope--toggle-attribute#enable"
                            {% if add_shipping_address %} checked{% endif %}
                        >
                        <label for="ctrl_add_shipping_address_1">{{ 'MSC.differentShippingAddress'|trans }}</label>
                    </span>
                </fieldset>
                <fieldset class="hide-disabled" data-isotope--toggle-attribute-target="receiver"{% if not add_shipping_address %} disabled{% endif %}>
                    {% embed '@Contao/isotope/address_manager.html.twig' with shipping_address_manager|merge({ current: shipping_address }) %}
                        {% trans_default_domain 'contao_default' %}
                        {% block address %}
                            {% if not address.isValid %}<p class="message error">{{ 'MSC.address_error'|trans }}</p>{% endif %}
                            <span>
                            <input
                                id="opt_shipping_address_{{ address.data.id }}"
                                type="radio"
                                form="{{ form_id }}"
                                name="shipping_address_id"
                                class="radio"
                                value="{{ address.data.id }}"
                                required
                                {% if not address.isValid %}
                                    disabled
                                {% elseif (addresses|length == 1 or address.data.id == current.id|default) %}
                                    checked
                                {% endif %}
                            >
                            <label for="opt_shipping_address_{{ address.data.id }}">
                                {% with address only %}{{ block('isotope_address_component') }}{% endwith %}
                            </label>
                        </span>
                        {% endblock %}
                    {% endembed %}
                </fieldset>
            </fieldset>
        </form>
    {% endif %}
{% endblock %}
