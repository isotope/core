{% trans_default_domain 'contao_default' %}

<div{{ attributes|default }}>
    {% block content %}
        {% if review %}
            {{ review }}
        {% else %}
            <p>{{ label }}</p>
        {% endif %}
    {% endblock %}

    {% if edit_step|default %}
        <form method="POST" data-action="isotope--fragment#submit">
            <input type="hidden" name="{{ edit_step }}" value="1">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
            <button type="submit" class="submit">{{ 'MSC.changeCheckoutInfo'|trans }}</button>
        </form>
    {% endif %}
</div>
