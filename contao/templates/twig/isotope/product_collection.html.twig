{% trans_default_domain 'contao_default' %}

{% block product_collection %}
    {% if block("product_collection_actions") is defined %}
        <form id="{{ fragment_id }}" method="post" data-isotope--collection-target="form">
            <div class="formbody">
                <input type="hidden" name="FORM_SUBMIT" value="{{ fragment_id }}">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
    {% endif %}

                {#<?php if ($this->collection->hasErrors()): ?>
                <p class="error"><?= implode('</p><p class="error">', $this->collection->getErrors()) ?></p>
                <?php endif; ?>#}

                <table>
                    <thead>
                        <tr>
                            <th class="name"></th>
                            <th class="quantity">Quantity</th>
                            <th class="price">Price</th>
                            <th class="total">Total</th>
                            {% if multiple_taxes|default %}
                                <th class="tax_id"></th>
                            {% endif %}
                            {% if block("product_collection_item_actions") is defined %}
                                <th class="actions"></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for level,items in collection.lineItems.byLevel %}
                            {% for item in items %}
                                {% block product_collection_item %}
                                    <tr>
                                        {#<?php if(!$this->isNotification): ?>
                                        <td class="image"><?= $this->getGallery('images', $item['item'])->generateMainImage() ?></td>
                                        <?php endif; ?>#}
                                        <td class="name">
                                            {{ block('item_name') }}
                                            {{ block('item_attributes') }}
                                        </td>
                                        <td class="quantity">
                                            {% if not item.isDynamic %}
                                                {% if editable|default %}
                                                    <input name="quantity[{{ item.id }}]" type="number" class="text" value="{{ item.quantity }}" maxlength="10">
                                                {% else %}
                                                    {{ item.quantity }} x
                                                {% endif %}
                                            {% endif %}
                                        </td>
                                        {% set price = isotope_price(item) %}
                                        <td class="price">
                                            {{ price|raw }}
                                            {% if show_taxes|default %}
                                                <div class="tax">
                                                    {% if price.is_gross|default %}incl.{% else %}.excl{% endif %}
                                                    {{ price.with({ amount: price.unit_tax }) }}
                                                    VAT
                                                </div>
                                            {% endif %}
                                        </td>
                                        <td class="total">
                                            {{ price.with({ amount: price.total_price }) }}
                                        </td>
                                        {% if multiple_taxes|default %}
                                            <td class="tax_id">{{ price.tax_ids|default([])|join(',') }}</td>
                                        {% endif %}
                                        {% if block('product_collection_item_actions') is defined %}
                                            <td class="actions">
                                                {#<?php if ($item['edit_href'] ?? null): ?><a href="<?= $item['edit_href'] ?>" class="edit" title="<?= $item['edit_title'] ?>"><?= $item['edit_link'] ?></a><?php endif; ?>#}
                                                {{ block('product_collection_item_actions') }}
                                            </td>
                                        {% endif %}
                                    </tr>
                                    {% if item.hasErrors %}
                                        <tr>
                                            <td colspan="5">
                                                {% for error in item.errors %}
                                                    <p class="error">{{ error|trans }}</p>
                                                {% endfor %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endblock %}
                            {% endfor %}
                            {% if not loop.last or level == 0 %}
                                {% block product_collection_subtotal %}
                                    <tr class="subtotal">
                                        <td class="name" colspan="2">{{ 'MSC.subTotalLabel'|trans }}</td>
                                        <td class="price">&nbsp;</td>
                                        <td class="price total">
                                            {{ isotope_price(collection.subtotal(level)) }}
                                        </td>
                                        {% if multiple_taxes|default %}
                                            <td class="tax_id">&nbsp;</td>
                                        {% endif %}
                                        {% if block("product_collection_item_actions") is defined %}
                                            <td class="actions">&nbsp;</td>
                                        {% endif %}
                                    </tr>
                                {% endblock %}
                            {% endif %}
                        {% endfor %}
                        {% set total = isotope_price(collection.total) %}
                        {% block product_collection_taxes %}
                            {% for tax in total.calculated_taxes %}
                                <tr class="tax">
                                    <td class="name" colspan="2">{{ tax.label }}</td>
                                    <td class="price">{{ tax.taxRate }}%</td>
                                    <td class="price total">
                                        {{ total.with({ amount: tax.amount }) }}
                                    </td>
                                    {% if multiple_taxes|default %}
                                        <td class="tax_id">{{ tax.number }}</td>
                                    {% endif %}
                                    {% if block("product_collection_item_actions") is defined %}
                                        <td class="actions">&nbsp;</td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        {% endblock %}
                        {% block product_collection_total %}
                            <tr class="total">
                                <td class="name" colspan="2">{{ 'MSC.grandTotalLabel'|trans }}</td>
                                <td class="price">&nbsp;</td>
                                <td class="price total">
                                    {{ total|raw }}
                                </td>
                                {% if multiple_taxes|default %}
                                    <td class="tax_id">&nbsp;</td>
                                {% endif %}
                                {% if block("product_collection_item_actions") is defined %}
                                    <td class="actions">&nbsp;</td>
                                {% endif %}
                            </tr>
                        {% endblock %}
                    </tbody>
                </table>

    {% if block("product_collection_actions") is defined %}
            </div>
            <div class="submit_container">
                {{ block("product_collection_actions") }}
            </div>
        </form>
    {% endif %}
{% endblock %}

{% block product_collection_downloads %}
    {#<?php if (!$this->isEditable && !empty($this->downloads) && \is_array($this->downloads)): ?>
    <div class="downloads">
        <h2><?= $GLOBALS['TL_LANG']['MSC']['downloadsLabel'] ?></h2>
        <ul>
            <?php foreach ($this->downloads as $download): ?>
            <li class="<?= $download['downloadable'] ? 'available' : 'unavailable' ?>"><?php if ($download['downloadable'] && $download['href']): ?><a href="<?= $download['href'] ?>"><?php endif; echo $download['title']; if ($download['downloadable'] && $download['href']): ?></a><?php endif; echo $download['remaining']; ?></li>
            <?php endforeach; ?>
        </ul>
    </div>
    <?php endif; ?>

    <?php endif; ?>#}
{% endblock %}

{% block item_name %}
    {% set href = content_url(item) %}
    {% if href %}
        <a href="{{ href }}">{{ item.label }}</a>
    {% else %}
        {{ item.label }}
    {% endif %}
{% endblock %}

{% block item_attributes %}
    {% set configuration = item.configuration %}
    {% if configuration is not empty %}
        <ul>
            {% for attribute, value in configuration %}
                <li><strong>{{ isotope_attribute_label(attribute) }}:</strong> {{ isotope_attribute_value(attribute, value)|join(', ') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
