{% trans_default_domain 'contao_default' %}
{% use '@Contao/component/isotope_collection_item.html.twig' %}
{% use '@Contao/component/isotope_price.html.twig' %}

{% block product_collection %}
    {% if block("product_collection_actions") is defined %}
        <form id="{{ fragment_id }}" method="post" data-isotope--collection-target="form">
            <div class="formbody">
                <input type="hidden" name="FORM_SUBMIT" value="{{ fragment_id }}">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
    {% endif %}

                {#<?php if ($this->collection->hasErrors()): ?>
                <p class="error"><?= implode('</p><p class="error">', $this->collection->getErrors()) ?></p>
                <?php endif; ?>#}

                <table>
                    <thead>
                        <tr>
                            <td class="name"></td>
                            <td class="quantity">Quantity</td>
                            <td class="price">Price</td>
                            <td class="total">Total</td>
                            {% if multiple_taxes|default %}
                                <td class="tax_id"></td>
                            {% endif %}
                            {% if block("product_collection_item_actions") is defined %}
                                <td class="actions"></td>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for level,items in collection.lineItems.byLevel %}
                            {% for item in items %}
                                {% block product_collection_item %}
                                    <tr>
                                        {#<?php if(!$this->isNotification): ?>
                                        <td class="image"><?= $this->getGallery('images', $item['item'])->generateMainImage() ?></td>
                                        <?php endif; ?>#}
                                        <td class="name">
                                            {{ block('item_name') }}
                                            {{ block('item_attributes') }}
                                        </td>
                                        <td class="quantity">
                                            {% if editable|default %}
                                                <input name="quantity[{{ item.id }}]" type="number" class="text" value="{{ item.quantity }}" maxlength="10">
                                            {% else %}
                                                {{ item.quantity }} x
                                            {% endif %}
                                        </td>
                                        {% set price = isotope_price(item) %}
                                        <td class="price">
                                            {% with price only %}{{ block('unit_price_component') }}{% endwith %}
                                            {% if show_taxes|default %}
                                                <div class="tax">
                                                    {% if price.is_gross|default %}incl.{% else %}.excl{% endif %}
                                                    {% with price only %}{{ block('unit_tax_component') }}{% endwith %}
                                                    VAT
                                                </div>
                                            {% endif %}
                                        </td>
                                        <td class="total">
                                            {% with price only %}{{ block('total_price_component') }}{% endwith %}
                                        </td>
                                        {% if multiple_taxes|default %}
                                            <td class="tax_id">{{ price.tax_ids|default([])|join(',') }}</td>
                                        {% endif %}
                                        {% if block("product_collection_item_actions") is defined %}
                                            <td class="actions">
                                                {#<?php if ($item['edit_href'] ?? null): ?><a href="<?= $item['edit_href'] ?>" class="edit" title="<?= $item['edit_title'] ?>"><?= $item['edit_link'] ?></a><?php endif; ?>#}
                                                {% block product_collection_item_actions %}{% endblock %}
                                            </td>
                                        {% endif %}
                                    </tr>
                                    {% if item.hasErrors %}
                                        <tr>
                                            <td colspan="5">
                                                {% for error in item.errors %}
                                                    <p class="error">{{ error|trans }}</p>
                                                {% endfor %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endblock %}
                            {% endfor %}
                            {% if not loop.last %}
                                {% block product_collection_subtotal %}
                                    <tr class="subtotal">
                                        <td class="name" colspan="2">{{ 'MSC.subTotalLabel'|trans }}</td>
                                        <td class="price">&nbsp;</td>
                                        <td class="price total">
                                            {% with isotope_price(collection.subtotal(level)) only %}{{ block('total_price_component') }}{% endwith %}
                                        </td>
                                        {% if multiple_taxes|default %}
                                            <td class="tax_id">&nbsp;</td>
                                        {% endif %}
                                        {% if block("product_collection_item_actions") is defined %}
                                            <td class="actions">&nbsp;</td>
                                        {% endif %}
                                    </tr>
                                {% endblock %}
                            {% endif %}
                        {% endfor %}
                        {% set total_price = isotope_price(collection.total) %}
                        {% block product_collection_taxes %}
                            {% for tax in collection.total.calculatedTaxes %}
                                <tr class="tax">
                                    <td class="name" colspan="2">{{ tax.label }}</td>
                                    <td class="price">{{ tax.taxRate }}%</td>
                                    <td class="price total">
                                        {% with total_price|merge({ amount: tax.tax }) only %}{{ block('isotope_price_component') }}{% endwith %}
                                    </td>
                                    {% if multiple_taxes|default %}
                                        <td class="tax_id">{{ tax.number }}</td>
                                    {% endif %}
                                    {% if block("product_collection_item_actions") is defined %}
                                        <td class="actions">&nbsp;</td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        {% endblock %}
                        {% block product_collection_total %}
                            <tr class="total">
                                <td class="name" colspan="2">{{ 'MSC.grandTotalLabel'|trans }}</td>
                                <td class="price">&nbsp;</td>
                                <td class="price total">
                                    {% with total_price only %}{{ block('isotope_price_component') }}{% endwith %}
                                </td>
                                {% if multiple_taxes|default %}
                                    <td class="tax_id">&nbsp;</td>
                                {% endif %}
                                {% if block("product_collection_item_actions") is defined %}
                                    <td class="actions">&nbsp;</td>
                                {% endif %}
                            </tr>
                        {% endblock %}
                    </tbody>
                </table>

    {% if block("product_collection_actions") is defined %}
            </div>
            <div class="submit_container">
                {% block product_collection_actions %}{% endblock %}
            </div>
        </form>
    {% endif %}
{% endblock %}

