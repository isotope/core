{% trans_default_domain 'contao_default' %}
{% use '@Contao/component/isotope_collection_item.html.twig' %}

{% block product_collection %}
    {% if block("product_collection_actions") is defined %}
        <form id="{{ fragment_id }}" method="post" data-isotope--collection-target="form">
            <div class="formbody">
                <input type="hidden" name="FORM_SUBMIT" value="{{ fragment_id }}">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
    {% endif %}

                {#<?php if ($this->collection->hasErrors()): ?>
                <p class="error"><?= implode('</p><p class="error">', $this->collection->getErrors()) ?></p>
                <?php endif; ?>#}

                <table>
                    <tbody>
                    {% for item in collection.lineItems %}
                        {% block product_collection_item %}
                            <tr>
                                {#<?php if(!$this->isNotification): ?>
                                <td class="image"><?= $this->getGallery('images', $item['item'])->generateMainImage() ?></td>
                                <?php endif; ?>#}
                                <td class="name">
                                    {{ block('item_name') }}
                                    {{ block('item_attributes') }}
                                </td>
                                <td class="quantity">
                                    {% if editable|default %}
                                        <input name="quantity[{{ item.id }}]" type="number" class="text" value="{{ item.quantity }}" maxlength="10">
                                    {% else %}
                                        {{ item.quantity }} x
                                    {% endif %}
                                </td>
                                {% set price = isotope_price(item) %}
                                <td class="price">
                                    {% if price %}
                                        {{ include('@Contao/component/isotope_price.html.twig', price, with_context: false) }}
                                    {% endif %}
                                </td>
                                <td class="price total">
                                    {% if price %}
                                        {{ include('@Contao/component/isotope_price.html.twig', price|merge({ amount: price.totalPrice }), with_context: false) }}
                                    {% endif %}
                                </td>{# <?php if ($this->total_tax_ids > 1): ?>
                                <td class="tax"><?= $item['tax_id'] ?></td>#}
                                {% if block("product_collection_item_actions") is defined %}
                                    <td class="actions">
                                        {#<?php if ($item['edit_href'] ?? null): ?><a href="<?= $item['edit_href'] ?>" class="edit" title="<?= $item['edit_title'] ?>"><?= $item['edit_link'] ?></a><?php endif; ?>#}
                                        {% block product_collection_item_actions %}{% endblock %}
                                    </td>
                                {% endif %}
                            </tr>
                            {% if item.hasErrors %}
                                <tr>
                                    <td colspan="5">
                                        {% for error in item.errors %}
                                            <p class="error">{{ error|trans }}</p>
                                        {% endfor %}
                                    </td>
                                </tr>
                            {% endif %}
                        {% endblock %}
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    {% block product_collection_subtotal %}
                        <tr class="subtotal">
                            <td class="name" colspan="2">{{ 'MSC.subTotalLabel'|trans }}</td>
                            <td class="price">&nbsp;</td>
                            <td class="price total">
                                {{ include('@Contao/component/isotope_price.html.twig', isotope_price(collection.lineItems|first)|merge({ amount: collection.subtotal }), with_context: false) }}
                            </td>
                            {#<?php if ($this->total_tax_ids > 1): ?>
                            <td class="tax">&nbsp;</td><?php endif; ?>#}
                            {% if block("product_collection_item_actions") is defined %}
                                <td class="actions">&nbsp;</td>
                            {% endif %}
                        </tr>
                    {% endblock %}
                    {% block product_collection_surcharges %}
                        {#<?php foreach ($this->surcharges as $surcharge): $i=0; ?>
                        <tr class="<?= $surcharge['rowClass'] ?>">
                            <?php if(!$this->isNotification): ?>
                            <td>&nbsp;</td><?php endif; ?>
                            <td class="name" colspan="2"><?= $surcharge['label'] ?></td>
                            <td class="price"><?= $surcharge['price'] ?></td>
                            <td class="price total"><?= $surcharge['total_price'] ?></td><?php if ($this->total_tax_ids > 1): ?>
                            <td class="tax"><?= $surcharge['tax_id'] ?></td><?php endif; ?>
                            {% if block("product_collection_item_actions") is defined %}
                                <td class="actions">&nbsp;</td>
                            {% endif %}
                        </tr>
                        <?php endforeach; ?>#}
                    {% endblock %}
                    {% block product_collection_total %}
                        <tr class="total">
                            <td class="name" colspan="2">{{ 'MSC.grandTotalLabel'|trans }}</td>
                            <td class="price">&nbsp;</td>
                            <td class="price total">
                                {{ include('@Contao/component/isotope_price.html.twig', isotope_price(collection.total), with_context: false) }}
                            </td>
                            {#<?php if ($this->total_tax_ids > 1): ?>
                            <td class="tax">&nbsp;</td>#}
                            {% if block("product_collection_item_actions") is defined %}
                                <td class="actions">&nbsp;</td>
                            {% endif %}
                        </tr>
                    {% endblock %}
                    </tfoot>
                </table>

    {% if block("product_collection_actions") is defined %}
            </div>
            <div class="submit_container">
                {% block product_collection_actions %}{% endblock %}
            </div>
        </form>
    {% endif %}
{% endblock %}

{% block product_collection_downloads %}
    {#<?php if (!$this->isEditable && !empty($this->downloads) && \is_array($this->downloads)): ?>
    <div class="downloads">
        <h2><?= $GLOBALS['TL_LANG']['MSC']['downloadsLabel'] ?></h2>
        <ul>
            <?php foreach ($this->downloads as $download): ?>
            <li class="<?= $download['downloadable'] ? 'available' : 'unavailable' ?>"><?php if ($download['downloadable'] && $download['href']): ?><a href="<?= $download['href'] ?>"><?php endif; echo $download['title']; if ($download['downloadable'] && $download['href']): ?></a><?php endif; echo $download['remaining']; ?></li>
            <?php endforeach; ?>
        </ul>
    </div>
    <?php endif; ?>

    <?php endif; ?>#}
{% endblock %}
