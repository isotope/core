{% macro button(name, label, attributes) %}
    {% set attributes = attrs()
        .set('type', 'submit')
        .set('name', '_action')
        .set('value', name)
        .addClass(['submit', name])
        .mergeWith(attributes)
    %}
    <button{{ attributes }}>{{ label }}</button>
{% endmacro %}

{% macro link(href, label, attributes) %}
    {% set attributes = attrs()
        .set('href', href)
        .mergeWith(attributes)
    %}
    <a{{ attributes}}>{{ label }}</a>
{% endmacro %}
