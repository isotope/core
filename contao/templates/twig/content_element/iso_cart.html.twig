{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}
{% use '@Contao/isotope/collection/default.html.twig' %}

{% set attributes = attrs()
    .set('data-controller', 'isotope--collection isotope--fragment')
    .set('data-isotope--collection-id-value', fragment_id)
    .set('data-isotope--collection-type-value', 'cart')
    .set('data-isotope--fragment-id-value', fragment_id)
    .set('data-action', 'isotope--product:submit.add_to_cart@window->isotope--fragment#update isotope--collection:submit.cart@window->isotope--fragment#update')
    .mergeWith(attributes|default)
%}

{% block content %}
    {% if collection.isEmpty %}
        {% include('@Contao/component/isotope_empty.html.twig') %}
    {% else %}
        {% with { editable: true } %}
            {{ block('product_collection') }}
        {% endwith %}
    {% endif %}
{% endblock %}

{% block product_collection_actions %}
    {{ isotope_product_collection_action('update_cart') }}
    {{ isotope_product_collection_action('submit_to_cart') }}
    {{ isotope_product_collection_action('submit_to_checkout') }}
    {{ isotope_product_collection_action('continue_shopping') }}
{% endblock %}

{% block product_collection_item_actions %}
    {{ isotope_product_collection_item_action('remove_from_cart') }}
{% endblock %}
