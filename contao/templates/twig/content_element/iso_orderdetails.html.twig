{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_isotope_base.html.twig' %}
{% use '@Contao/isotope/product_collection.html.twig' %}

{% set attributes = attrs()
    .set('data-controller', 'isotope--collection isotope--fragment')
    .set('data-isotope--collection-id-value', fragment_id)
    .set('data-isotope--collection-type-value', 'order')
    .set('data-isotope--fragment-id-value', fragment_id)
    .mergeWith(attributes|default)
%}

{% block content %}

    <h2>{{ 'MSC.orderDetailsHeadline'|trans([order.documentNumber, order.locked|date(contao.page.datimFormat)]) }}</h2>
    <div class="order_status {{ order.orderStatus.alias }}">{{ 'MSC.orderStatusHeadline'|trans([order.orderStatus.label|default(order.orderStatus.name)|trans([], 'isotope')]) }}</div>

    {% if order.billingAddress %}
        {% if order.shippingMethod and not order.shippingAddress %}
            <h3>{{ 'MSC.billing_shipping_address'|trans }}</h3>
        {% elseif order.paymentMethod %}
            <h3>{{ 'MSC.billing_address'|trans }}</h3>
        {% else %}
            <h3>{{ 'MSC.customer_address'|trans }}</h3>
        {% endif %}
        {{ isotope_address(order.billingAddress, order.context.billingAddressConfig) }}
    {% endif %}

    {% if order.shippingAddress %}
        <h3>{{ 'MSC.shipping_address'|trans }}</h3>
        {{ isotope_address(order.shippingAddress, order.context.shippingAddressConfig) }}
    {% endif %}

    {% if order.shippingMethod %}
        <h3>{{ 'MSC.shipping_method'|trans }}</h3>
        {{ order.shippingMethod.label }}
    {% endif %}

    {% if order.paymentMethod %}
        <h3>{{ 'MSC.payment_method'|trans }}</h3>
        {{ order.paymentMethod.label }}
    {% endif %}

    {% with {collection: order} %}
        <h3>{{ 'MSC.order_review'|trans }}</h3>
        {{ block('product_collection') }}
    {% endwith %}

{% endblock %}

{% block product_collection_actions %}
    {{ isotope_product_collection_action('reorder') }}
{% endblock %}
