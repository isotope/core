{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/iso_cart.html.twig' %}
{% use '@Contao/isotope/product_collection.html.twig' %}

{% block product_collection %}
    {% from '@Contao/isotope/price_macros.html.twig' import format_price %}

    {% for item in collection.lineItems %}
        {% block product_collection_item %}
            {% from '@Contao/isotope/price_macros.html.twig' import format_unit_price, format_total_price %}

            <div class="product">
                {% if block("product_collection_item_actions") is defined %}
                    <div class="actions">
                        {% block product_collection_item_actions %}
                            {{ isotope_product_collection_item_action('remove_from_cart') }}
                        {% endblock %}
                    </div>
                {% endif %}
                <div class="name">{{ block('item_name') }}</div>
                <div class="info">
                    {{ block('item_attributes') }}
                    {% set price = isotope_price(item) %}
                    {% if price %}
                        <div class="price">{{ item.quantity }} x {{ format_unit_price(price) }}= <span class="total">{{ format_total_price(price) }}</span></div>
                    {% endif %}
                </div>
            </div>
        {% endblock %}
    {% endfor %}
    <div class="subtotal">
        <span class="label">{{ 'MSC.subTotalLabel'|trans }}</span>
        {{ format_price(isotope_price(collection.subtotal)) }}
    </div>
    {% block product_collection_actions %}
        <div class="cart">{{ isotope_product_collection_action('link_to_cart') }}</div>
        <div class="checkout">{{ isotope_product_collection_action('link_to_checkout') }}</div>
    {% endblock %}
{% endblock %}
