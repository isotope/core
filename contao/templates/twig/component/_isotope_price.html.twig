{% block isotope_price_component %}
    {% set html = html is defined ? html : true %}
    {% set space = html ? '&nbsp;' : ' ' %}
    {% set amount = amount|default(unit_price|default(0)) %}
    {%- set price -%}
        {%- set symbol = currency.symbol -%}
        {%- if currency.after -%}{{- money.format(amount) -}}{%- endif -%}
        {%- if currency.after and (not symbol or currency.space) -%}{{ space }}{%- endif -%}
        {%- if html -%}<span class="currency">{%- endif -%}
        {%- if symbol -%}{{- symbol -}}{%- else -%}{{- currency.code -}}{%- endif -%}
        {%- if html -%}</span>{%- endif -%}
        {%- if not currency.after and (not symbol or currency.space) -%}{{ space }}{%- endif -%}
        {%- if not currency.after -%}{{- money.format(amount) -}}{% endif %}
    {%- endset -%}
    {%- if isRange|default -%}{{ 'MSC.priceRangeLabel'|trans([price], 'contao_default')|raw }}{% else %}{{ price }}{% endif %}
{% endblock %}
