{% block item_name %}
    {% set href = content_url(item) %}
    {% if href %}
        <a href="{{ href }}">{{ item.label }}</a>
    {% else %}
        {{ item.label }}
    {% endif %}
{% endblock %}

{% block item_attributes %}
    {% set configuration = item.configuration %}
    {% if configuration is not empty %}
        <ul>
            {% for attribute, value in configuration %}
                <li><strong>{{ isotope_attribute_label(attribute) }}:</strong> {{ isotope_attribute_value(attribute, value)|join(', ') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
