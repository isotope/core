<table class="tl_listing showColumns">
    <thead>
    <tr>
        <td class="tl_folder_tlist">{{ dca_label('tl_iso_product_price', 'price_tiers') }}</td>
        <td class="tl_folder_tlist">{{ dca_label('tl_iso_product_price', 'tax_class') }}</td>
        <td class="tl_folder_tlist">{{ dca_label('tl_iso_product_price', 'config_id') }}</td>
        <td class="tl_folder_tlist">{{ dca_label('tl_iso_product_price', 'member_group') }}</td>
        <td class="tl_folder_tlist">{{ dca_label('tl_iso_product_price', 'start') }}</td>
        <td class="tl_folder_tlist">{{ dca_label('tl_iso_product_price', 'stop') }}</td>
        <td class="tl_folder_tlist">&nbsp;</td>
    </tr>
    </thead>
    <tbody>
    {% for price in prices %}
        <tr>
            <td class="tl_file_list">{{ price.tiers|join(', ') }}</td>
            <td class="tl_file_list">{{ dca_value('tl_iso_product_price', 'tax_class', price.tax_class)|default('-') }}</td>
            <td class="tl_file_list">{{ dca_value('tl_iso_product_price', 'config_id', price.config_id)|default('-') }}</td>
            <td class="tl_file_list">{{ dca_value('tl_iso_product_price', 'member_group', price.member_group)|default('-') }}</td>
            <td class="tl_file_list">{{ dca_value('tl_iso_product_price', 'member_group', price.start)|default('-') }}</td>
            <td class="tl_file_list">{{ dca_value('tl_iso_product_price', 'member_group', price.stop)|default('-') }}</td>
            <td class="tl_file_list tl_right_nowrap">{{ price.operations|raw }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
