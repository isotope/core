{% trans_default_domain 'contao_default' %}

{% for item in collection.lineItems %}
    {{- item.label }}
    {%- set options = item.options -%}
    {%- if options is not empty -%}
        (
            {% for attribute, value in item.options %}
                {% if not loop.first %}, {% endif %}
                {{ isotope_attribute_label(attribute) }}: {{ isotope_attribute_value(attribute, value) }}
            {% endfor %}
        )
    {%- endif -%}
{% endfor %}
