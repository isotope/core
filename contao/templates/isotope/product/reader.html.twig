{% extends '@Contao/isotope/product.html.twig' %}

{% set gallery = isotope_gallery(product, 'images') %}

{% block formbody %}

    <img src="{{ path('isotope_product_hits', { hashid: product.id|hashid }) }}" alt="" width="1" height="1" aria-hidden="true" style="position:absolute">

    <h2>{{ product.name }}</h2>

    {{ block('main_image') }}

    {{ block('product_options') }}

    {{ block('gallery_images') }}

    {% if product.sku|default %}<div class="sku">{{ product.sku }}</div>{% endif %}
    {% if product.description|default %}<div class="description">{{ product.description|csp_inline_styles|insert_tag|encode_email|raw }}</div>{% endif %}

    {{ block('product_price') }}
    {{ block('product_actions') }}

{% endblock %}
