{% trans_default_domain 'contao_default' %}
{% extends '@Contao/isotope/product.html.twig' %}

{% set href = content_url(view.productReference(product)) %}

{% block formbody %}

    <h3>{% if href|default %}<a href="{{ href }}">{% endif %}{{ product.name }}{% if href|default %}</a>{% endif %}</h3>

    {{ block('main_image') }}

    {% if product.sku|default %}<div class="sku">{{ product.sku }}</div>{% endif %}
    {% if product.teaser|default %}<div class="teaser">{{ product.teaser|nl2br }}</div>{% endif %}

    {{ block('product_price') }}

    {% if href|default %}
        <div class="details"><a href="{{ href }}">{{ 'MSC.detailLabel'|trans }}</a></div>
    {% endif %}

    {{ block('product_options') }}
    {{ block('product_actions') }}

{% endblock %}
