{% trans_default_domain 'contao_default' %}

{% set product_attributes = attrs()
    .setIfExists('id', product_html_id)
    .addClass(['product', product_css_classes, type.cssClass])
    .addClass('active', isActive)
    .mergeWith(product_attributes|default)
%}
{% if configuration %}
    {% set product_attributes = attrs()
        .set('data-controller', 'isotope--product')
        .set('data-isotope--product-form-id-value', view.formId(product))
        .set('data-isotope--product-attributes-value', configuration.ajaxAttributes|json_encode)
        .mergeWith(product_attributes|default)
    %}

    {% set form_attributes = attrs()
        .set('id', view.formId(product))
        .set('method', 'post')
        .set('enctype', 'multipart/form-data', configuration and configuration.hasUploads)
        .set('data-isotope--product-target', 'form')
        .set('data-action', 'isotope--product#submit')
        .mergeWith(form_attributes|default)
    %}
{% endif %}

<div{{ product_attributes }}>
    {% if configuration %}
    <form{{ form_attributes }}>
        <div class="formbody">
            <input type="hidden" name="FORM_SUBMIT" value="{{ view.formId(product) }}">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
    {% endif %}
            {% block formbody %}
                <h2>{{ product.name }}</h2>

                {% block main_image %}
                    {% if gallery is not defined %}{% set gallery = isotope_gallery(product, 'images') %}{% endif %}
                    {{ gallery?.with({ type: 'main' }) }}
                {% endblock %}

                {% block gallery_images %}
                    {% if gallery is not defined %}{% set gallery = isotope_gallery(product, 'images') %}{% endif %}
                    {{ gallery?.with({ type: 'gallery' }) }}
                {% endblock %}

                {% block product_options %}
                    {% if configuration %}
                        <div class="options">
                            {% for widget in configuration.widgets %}
                                {{ widget.parse|raw }}
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endblock %}

                {% block product_price %}
                    {% set price = isotope_price(product) %}
                    {% if price %}
                        <div class="offer">
                            <div class="price">{{ price }}</div>
                            {% set baseprice = isotope_baseprice(product) %}
                            {% if baseprice %}
                                <div class="baseprice">{{ baseprice }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endblock %}

                {% block product_actions %}
                    {% set actions = view.actions(product) %}
                    {% if actions is not empty %}
                        <div class="submit_container">

                            {% block product_quantity %}
                                {% if view.useQuantity(product) %}
                                    <div class="quantity_container">
                                        <label for="quantity_requested_{{ product.id }}">{{ 'MSC.quantity'|trans }}:</label>
                                        <input type="number" class="text" id="quantity_requested_{{ product.id }}" name="quantity_requested" placeholder="{{ product.extension('Isotope\\CoreBundle\\Product\\Extension\\QuantityExtension').minimum|default(1) }}" value="{#<?= \Contao\StringUtil::specialchars(\Contao\Input::post('quantity_requested')); ?>#}" maxlength="10">
                                    </div>
                                {% endif %}
                            {% endblock %}

                            {% for action in actions %}
                                {{ isotope_product_action(action, product, view, configuration) }}
                            {% endfor %}

                        </div>
                    {% endif %}
                {% endblock %}

            {% endblock %}
    {% if configuration %}
        </div>
    </form>
    {% endif %}
</div>

{% block product_jsonld %}{% endblock %}
