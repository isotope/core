{% trans_default_domain 'contao_default' %}

{% block product_collection %}
    {% set href = null %}
    {% set has_actions = block('product_collection_actions') is defined or block('product_collection_item_actions') is defined %}

    {% if has_actions %}
        {% set form_attributes = attrs()
            .set('id', fragment_id)
            .set('method', 'post')
            .set('data-action', 'isotope--collection#formAction')
            .set('data-isotope--collection-target', 'form')
            .mergeWith(form_attributes|default)
            .mergeWith(product_collection_attributes|default)
        %}
        <form{{ form_attributes }}>
            <input type="hidden" name="FORM_SUBMIT" value="{{ fragment_id }}">
            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
            <div class="formbody">
    {% endif %}

    {% block product_collection_inner %}
                {#<?php if ($this->collection->hasErrors()): ?>
                <p class="error"><?= implode('</p><p class="error">', $this->collection->getErrors()) ?></p>
                <?php endif; ?> #}

                <table{{ attrs().mergeWith(product_collection_attributes|default, not has_actions) }}>
                    <thead>
                        <tr>
                            {% if data.iso_gallery|default %}
                                <th class="image"></th>
                            {% endif %}
                            <th class="name">{{ 'MSC.iso_order_description'|trans }}</th>
                            <th class="quantity">{{ 'MSC.iso_order_quantity'|trans }}</th>
                            <th class="price">{{ 'MSC.iso_order_price'|trans }}</th>
                            {% if show_taxes|default %}
                                <th class="tax">{{ 'MSC.iso_order_tax'|trans }}</th>
                            {% endif %}
                            <th class="total">{{ 'MSC.iso_order_total'|trans }}</th>
                            {% if multiple_taxes|default %}
                                <th class="tax_id"></th>
                            {% endif %}
                            {% if block('product_collection_item_actions') is defined %}
                                <th class="actions"></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% set colspan = 2 + (data.iso_gallery|default ? 1 : 0) + (show_taxes|default ? 1 : 0) %}
                        {% for level, items in collection.lineItems.byLevel %}
                            {% for item in items %}
                                {% block product_collection_item %}
                                    {% set href = item.productReference ? content_url(item.productReference) : null %}
                                    <tr>
                                        {% if data.iso_gallery|default and item.product %}
                                            <td class="image">
                                                {{ isotope_gallery(item.product, 'images', data.iso_gallery, href) }}
                                            </td>
                                        {% endif %}
                                        <td class="name"{% if data.iso_gallery|default and not item.product %} colspan="2"{% endif %}>
                                            {% block item_name %}
                                                {% if href %}
                                                    <a href="{{ href }}">{{ item.label }}</a>
                                                {% else %}
                                                    {{ item.label }}
                                                {% endif %}
                                            {% endblock %}
                                            {% block item_attributes %}
                                                {% set configuration = item.configuration %}
                                                {% if configuration is not empty %}
                                                    <ul>
                                                        {% for attribute, value in configuration %}
                                                            <li><strong>{{ isotope_attribute_label(attribute) }}:</strong> {{ isotope_attribute_value(attribute, value)|join(', ') }}</li>
                                                        {% endfor %}
                                                    </ul>
                                                {% endif %}
                                            {% endblock %}
                                        </td>
                                        <td class="quantity">
                                            {% if not item.isDynamic %}
                                                {% block item_quantity %}
                                                    {% if editable|default %}
                                                        <input name="quantity[{{ item.id }}]" type="number" class="text" value="{{ item.quantity }}" maxlength="10">
                                                    {% else %}
                                                        {{ item.quantity }} x
                                                    {% endif %}
                                                {% endblock %}
                                            {% endif %}
                                        </td>
                                        {% set price = isotope_price(item) %}
                                        <td class="price">
                                            {% if price %}
                                                {{ price }}
                                            {% endif %}
                                        </td>
                                        {% if show_taxes|default %}
                                            <td class="tax">
                                                {% if price %}
                                                    {{ price.with({amount: price.unit_tax}) }}
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                        <td class="total">
                                            {% if price %}
                                                {{ price.with({amount: price.total_price}) }}
                                            {% endif %}
                                        </td>
                                        {% if multiple_taxes|default %}
                                            <td class="tax_id">{{ price.tax_ids|default([])|join(',') }}</td>
                                        {% endif %}
                                        {% if block('product_collection_item_actions') is defined %}
                                            <td class="actions">
                                                {{ block('product_collection_item_actions') }}
                                            </td>
                                        {% endif %}
                                    </tr>
                                    {% if item.hasErrors %}
                                        <tr>
                                            <td colspan="{{ colspan + 2 + (multiple_taxes|default ? 1 : 0) + (block('product_collection_item_actions') is defined ? 1 : 0) }}">
                                                {% for error in item.errors %}
                                                    <p class="error">{{ error|trans }}</p>
                                                {% endfor %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endblock %}
                            {% endfor %}
                            {% if not loop.last or level == 0 %}
                                {% block product_collection_subtotal %}
                                    {% set price = isotope_price(collection.subtotal(level)) %}
                                    {% if price %}
                                        <tr class="subtotal">
                                            <td class="name" colspan="{{ colspan }}">{{ 'MSC.subTotalLabel'|trans }}</td>
                                            <td class="price">&nbsp;</td>
                                            <td class="price total">
                                                {{ isotope_price(collection.subtotal(level)) }}
                                            </td>
                                            {% if multiple_taxes|default %}
                                                <td class="tax_id">&nbsp;</td>
                                            {% endif %}
                                            {% if block('product_collection_item_actions') is defined %}
                                                <td class="actions">&nbsp;</td>
                                            {% endif %}
                                        </tr>
                                    {% endif %}
                                {% endblock %}
                            {% endif %}
                        {% endfor %}
                        {% set total = isotope_price(collection.total) %}
                        {% if total %}
                            {% block product_collection_taxes %}
                                {% for tax in total.calculated_taxes %}
                                    <tr class="tax">
                                        <td class="name" colspan="{{ colspan }}">{{ tax.label }}</td>
                                        <td class="price">{{ tax.taxRate }}%</td>
                                        <td class="price total">
                                            {{ total.with({amount: tax.amount}) }}
                                        </td>
                                        {% if multiple_taxes|default %}
                                            <td class="tax_id">{{ tax.number }}</td>
                                        {% endif %}
                                        {% if block('product_collection_item_actions') is defined %}
                                            <td class="actions">&nbsp;</td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                            {% endblock %}
                            {% block product_collection_total %}
                                <tr class="total">
                                    <td class="name" colspan="{{ colspan }}">{{ 'MSC.grandTotalLabel'|trans }}</td>
                                    <td class="price">&nbsp;</td>
                                    <td class="price total">
                                        {{ total }}
                                    </td>
                                    {% if multiple_taxes|default %}
                                        <td class="tax_id">&nbsp;</td>
                                    {% endif %}
                                    {% if block('product_collection_item_actions') is defined %}
                                        <td class="actions">&nbsp;</td>
                                    {% endif %}
                                </tr>
                            {% endblock %}
                        {% endif %}
                    </tbody>
                </table>
    {% endblock %}

    {% if block('product_collection_actions') is defined %}
            </div>
            <div class="submit_container">
                {{ block('product_collection_actions') }}
            </div>
        </form>
    {% endif %}
{% endblock %}
