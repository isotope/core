{% trans_default_domain 'contao_default' %}
{% extends '@Contao/isotope/checkout_step/_base.html.twig' %}

{% block inner %}
    {% if options is empty %}
        <p>{{ 'MSC.noPaymentModules'|trans }}</p>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    <fieldset class="radio_container">
        {% for option in options %}
            <span>
                <input
                    id="opt_payment_{{ option.id }}"
                    type="radio"
                    form="{{ form_id }}"
                    name="payment_id"
                    class="radio"
                    value="{{ option.id }}"
                    {% if options|length == 1 or option.id == current.id|default %} checked{% endif %}
                >
                <label for="opt_payment_{{ option.id }}">{{ option.label }}</label>
            </span>
        {% endfor %}
    </fieldset>
{% endblock %}
