<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/tl_iso_config.xlf" source-language="en" target-language="ru">
    <body>
      <trans-unit id="tl_iso_config.tableLabel">
        <source>Shop Configuration</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.name.0">
        <source>Configuration Name</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.name.1">
        <source>Please enter a name for your configuration. This is only used for back end reference.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.label.0">
        <source>Label</source>
        <target>Метка</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.label.1">
        <source>The label is used in frontend, e.g. for config switcher.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.firstname.0">
        <source>First name</source>
        <target>Имя</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.firstname.1">
        <source>Please enter the first name (if applicable).</source>
        <target>Пожалуйста, введите имя (если применимо).</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.lastname.0">
        <source>Last name</source>
        <target>Фамилия</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.lastname.1">
        <source>Please enter the last name (if applicable).</source>
        <target>Пожалуйста, введите фамилию (если применимо).</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.company.0">
        <source>Company</source>
        <target>Компания</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.company.1">
        <source>You can enter a company name here (if applicable).</source>
        <target>Вы можете ввести название компании здесь (если применимо).</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.vat_no.0">
        <source>VAT No.</source>
        <target>Номер VAT</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.vat_no.1">
        <source>Please enter a VAT number.</source>
        <target>Пожалуйста, введите номер VAT.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.street_1.0">
        <source>Street</source>
        <target>Улица</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.street_1.1">
        <source>Please enter the street name and the street number.</source>
        <target>Введите название и номер улицы.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.street_2.0">
        <source>Street 2</source>
        <target>Улица 2</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.street_2.1">
        <source>Enter a second street info if there&apos;s any.</source>
        <target>Введите информацию об улице 2, если она есть.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.street_3.0">
        <source>Street 3</source>
        <target>Улица 3</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.street_3.1">
        <source>Enter a third street info if there&apos;s any.</source>
        <target>Введите информацию об улице 3, если она есть.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.postal.0">
        <source>Postal code</source>
        <target>Почтовый индекс</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.postal.1">
        <source>Please enter the postal code.</source>
        <target>Пожалуйста, введите почтовый индекс.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.city.0">
        <source>City</source>
        <target>Город</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.city.1">
        <source>Please enter the name of the city.</source>
        <target>Пожалуйста, введите название города.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.subdivision.0">
        <source>State</source>
        <target>Штат</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.subdivision.1">
        <source>Please enter the name of the state.</source>
        <target>Пожалуйста, укажите название региона.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.country.0">
        <source>Country</source>
        <target>Страна</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.country.1">
        <source>Please select a country. This is also the default for custom shipping/billing addresses.</source>
        <target>Пожалуйста, выберите страну. Она также может быть по умолчанию для адресов доставки/платежного.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.phone.0">
        <source>Phone number</source>
        <target>Номер телефона</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.phone.1">
        <source>Please enter the phone number.</source>
        <target>Пожалуйста, введите номер телефона.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.email.0">
        <source>E-mail address</source>
        <target>Адрес электронной почты</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.email.1">
        <source>Please enter a valid e-mail address.</source>
        <target>Пожалуйста, введите правильный адрес электронной почты.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.bankName.0">
        <source>Bank name</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.bankName.1">
        <source>Please enter your bank name.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.bankAccount.0">
        <source>Bank account number (IBAN)</source>
        <target>Номер банковского аккаунта (IBAN)</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.bankAccount.1">
        <source>Please enter your bank account number (IBAN).</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.bankCode.0">
        <source>Bank code (BIC/SWIFT)</source>
        <target>Банковский код (BIC/SWIFT)</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.bankCode.1">
        <source>Please enter your bank code (BIC/SWIFT).</source>
        <target>Пожалуйста, введите ваш банковский код (BIC/SWIFT).</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.taxNumber.0">
        <source>Tax number</source>
        <target>Номер налогоплательщика</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.taxNumber.1">
        <source>Here you can enter your tax number.</source>
        <target>Здесь можно ввести ваш номер налогоплательщика</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.0">
        <source>Address fields</source>
        <target>Поля адреса</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.1">
        <source>Select the fields for a billing and shipping address when checking out.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.billing.0">
        <source>For billing address</source>
        <target>Для платежного адреса</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.shipping.0">
        <source>For shipping address</source>
        <target>Для платежного адреса</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.disabled">
        <source>Disabled</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.enabled">
        <source>Enabled (not mandatory)</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_fields.mandatory">
        <source>Enabled (mandatory)</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.billing_country.0">
        <source>Default billing country</source>
        <target>Страна платежа по умолчанию</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.billing_country.1">
        <source>Select a default country for new billing addresses.</source>
        <target>Выбрать страну по умолчанию для новых платежных адресов.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_country.0">
        <source>Default shipping country</source>
        <target>Страна доставки по умолчанию</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_country.1">
        <source>Select a default country for new shipping addresses.</source>
        <target>Выбрать страну по умолчанию для новых адресов доставки.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.billing_countries.0">
        <source>Available billing countries</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.billing_countries.1">
        <source>Select the countries you want to allow for checkout billing address. Select none to allow all countries.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_countries.0">
        <source>Available shipping countries</source>
        <target>Доступные страны доставки</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_countries.1">
        <source>Select the countries you want to allow for checkout shipping address. Select none to allow all countries.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.limitMemberCountries.0">
        <source>Limit member countries</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.limitMemberCountries.1">
        <source>Limit member countries (Registration, Personal Data) to the combined list of billing and shipping countries.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_ids.0">
        <source>Shipping methods</source>
        <target>Способы доставки</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_ids.1">
        <source>Select one or more shipping methods for the checkout.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.payment_ids.0">
        <source>Payment methods</source>
        <target>Способы оплаты</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.payment_ids.1">
        <source>Select one or more payment methods for the checkout.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.default_shipping.0">
        <source>Default shipping method</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.default_shipping.1">
        <source>Optionally select a default shipping method that should be applied to new carts.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.default_payment.0">
        <source>Default payment method</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.default_payment.1">
        <source>Optionally select a default payment method that should be applied to new carts.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceDisplay.0">
        <source>Price display</source>
        <target>Показ цен</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceDisplay.1">
        <source>Select if you want to display net or gross prices in your shop. See the help wizard for more information.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.taxCalculation.0">
        <source>Tax calculation</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.taxCalculation.1">
        <source>Select the tax calculation mode.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencyFormat.0">
        <source>Price formatting</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencyFormat.1">
        <source>Choose a formatting for prices.</source>
        <target>Выберите форматирование цен</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceRoundPrecision.0">
        <source>Rounding precision</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceRoundPrecision.1">
        <source>How much decimal precision to have. You should set something between 0 and 2 for all payment gateways to work correctly. See PHP manual for round().</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceRoundIncrement.0">
        <source>Rounding increment</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceRoundIncrement.1">
        <source>Some currencies (e.g. swiss francs) do not support 0.01 precision.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.currency.0">
        <source>Currency</source>
        <target>Валюта</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.currency.1">
        <source>Please select a currency for this store.</source>
        <target>Пожалуйста, выберите валюту для этого магазина.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencyPosition.0">
        <source>Position of currency code/symbol</source>
        <target>Расположение значка валюты</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencyPosition.1">
        <source>Select if you want to show currency on the left or right side of the price.</source>
        <target>Выберите для показа валюты слева или справа от цены.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencySymbol.0">
        <source>Use currency symbol</source>
        <target>Использовать символ валюты</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencySymbol.1">
        <source>Use a currency symbol ($, €) if available.</source>
        <target>Использовать символ валюты ($, €), если доступно.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencySpace.0">
        <source>Include blank space</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.currencySpace.1">
        <source>Add space between price and currency symbol.</source>
        <target>Добавить пробел между ценой и знаком валюты.</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceCalculateFactor.0">
        <source>Price factor</source>
        <target>Фактор цены</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.priceCalculateFactor.1">
        <source>Defaults should be 1. You can use this to convert between multiple currencies.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.orderPrefix.0">
        <source>Order number prefix</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.orderPrefix.1">
        <source>You can add a prefix (e.g. fiscal year) to the auto-incrementing order number.</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.orderDigits.0">
        <source>Order number length</source>
        <target>Длина номера заказа</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.orderDigits.1">
        <source>Select the minimum length of the order number (not including order prefix).</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.left">
        <source>To the left of price</source>
        <target>Слева от цены</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.right">
        <source>To the right of price</source>
        <target>Справа от цены</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.iwName.0">
        <source>Name</source>
        <target>Название</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.iwWidth.0">
        <source>Width</source>
        <target>Ширина</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.iwHeight.0">
        <source>Height</source>
        <target>Высота</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.iwMode.0">
        <source>Mode</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.ecb_int">
        <source>European Central Bank</source>
        <target>Европейский центральный банк</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.admin_ch">
        <source>Swiss Federal Department of Finance</source>
        <target>Министерство финансов Швейцарии</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.name_legend">
        <source>Name</source>
        <target>Название</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.address_legend">
        <source>Address configuration</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.config_legend">
        <source>Configuration</source>
        <target>Конфигурация</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.checkout_legend">
        <source>Checkout – Address</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.shipping_legend">
        <source>Checkout – Shipping</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.payment_legend">
        <source>Checkout – Payment</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.bank_legend">
        <source>Bank details</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.price_legend">
        <source>Price display &amp; currency formatting</source>
      </trans-unit>
      <trans-unit id="tl_iso_config.converter_legend">
        <source>Currency conversion</source>
        <target>Конвертация валюты</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.order_legend">
        <source>Orders</source>
        <target>Заказы</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.images_legend">
        <source>Images</source>
        <target>Изображения</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.url_legend">
        <source>URL settings</source>
        <target>Настройки URL</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.products_legend">
        <source>Products</source>
        <target>Товары</target>
      </trans-unit>
      <trans-unit id="tl_iso_config.analytics_legend">
        <source>Analytics</source>
        <target>Аналитика</target>
      </trans-unit>
    </body>
  </file>
