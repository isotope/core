        <target>Определить статус заказа.</target>
      </trans-unit>
      <trans-unit id="IMD.documents.0">
        <source>Documents</source>
        <target>Документы</target>
      </trans-unit>
      <trans-unit id="IMD.documents.1">
        <source>Define documents.</source>
        <target>Определить документы.</target>
      </trans-unit>
