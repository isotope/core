<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/modules.xlf" source-language="en" target-language="ru">
    <body>
      <trans-unit id="MOD.isotope">
        <source>Isotope eCommerce</source>
        <target>Isotope eCommerce</target>
      </trans-unit>
      <trans-unit id="MOD.iso_products.0">
        <source>Products</source>
        <target>Товары</target>
      </trans-unit>
      <trans-unit id="MOD.iso_products.1">
        <source>Manage products for your Isotope eCommerce shop.</source>
      </trans-unit>
      <trans-unit id="MOD.iso_orders.0">
        <source>Orders</source>
        <target>Заказы</target>
      </trans-unit>
      <trans-unit id="MOD.iso_orders.1">
        <source>See and manage orders for your shop.</source>
      </trans-unit>
      <trans-unit id="MOD.iso_rules.0">
        <source>Rules</source>
      </trans-unit>
      <trans-unit id="MOD.iso_rules.1">
        <source>Create rules to influence the store frontend.</source>
      </trans-unit>
      <trans-unit id="MOD.iso_setup.0">
        <source>Configuration</source>
        <target>Конфигурация</target>
      </trans-unit>
      <trans-unit id="MOD.iso_setup.1">
        <source>Setup and configure Isotope eCommerce to your needs.</source>
      </trans-unit>
      <trans-unit id="FMD.isotope">
        <source>Isotope eCommerce</source>
        <target>Isotope eCommerce</target>
      </trans-unit>
      <trans-unit id="IMD.product">
        <source>Products</source>
        <target>Товары</target>
      </trans-unit>
      <trans-unit id="IMD.attributes.0">
        <source>Attributes</source>
        <target>Атрибуты</target>
      </trans-unit>
      <trans-unit id="IMD.attributes.1">
        <source>Manage and create product attributes such as size, color, etc.</source>
        <target>Управляйте и создавайте атрибуты товара, такие как размер, цвет и т.д.</target>
      </trans-unit>
      <trans-unit id="IMD.producttypes.0">
        <source>Product types</source>
        <target>Типы товаров</target>
      </trans-unit>
      <trans-unit id="IMD.producttypes.1">
        <source>Manage and create product types from sets of attributes.</source>
        <target>Управляйте и создавайте типы товаров из наборов атрибутов.</target>
      </trans-unit>
      <trans-unit id="IMD.related_categories.0">
        <source>Related categories</source>
        <target>Связанные категории</target>
      </trans-unit>
      <trans-unit id="IMD.related_categories.1">
        <source>Define categories for product relations.</source>
        <target>Определите категории, связанные с товаром.</target>
      </trans-unit>
      <trans-unit id="IMD.gallery.0">
        <source>Galleries</source>
        <target>Галереи</target>
      </trans-unit>
      <trans-unit id="IMD.gallery.1">
        <source>Define how you want the images in your product to be rendered.</source>
      </trans-unit>
      <trans-unit id="IMD.baseprice.0">
        <source>Base prices</source>
        <target>Базовые цены</target>
      </trans-unit>
      <trans-unit id="IMD.baseprice.1">
        <source>Define base price.</source>
        <target>Определить базовую цену.</target>
      </trans-unit>
      <trans-unit id="IMD.checkout">
        <source>Checkout Flow</source>
        <target>Процесс оформления заказа</target>
      </trans-unit>
