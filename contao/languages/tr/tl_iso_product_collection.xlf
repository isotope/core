<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/tl_iso_product_collection.xlf" source-language="en" target-language="tr">
    <body>
      <trans-unit id="tl_iso_product_collection.tableLabel">
        <source>Order</source>
        <target>Sipariş</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.recordLabel">
        <source>Order #%s</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.id.0">
        <source>ID</source>
        <target>KİMLİK</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.document_number.0">
        <source>Order Number</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.member.0">
        <source>Member (empty for guests)</source>
        <target>Üye (misafirler için boş)</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.uniqid.0">
        <source>Unique ID</source>
        <target>Benzersiz ID</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.order_status.0">
        <source>Order status</source>
        <target>Sipariş durumu</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.order_status.1">
        <source>Select the status of this order.</source>
        <target>Bu siparişin durumunu seçin.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.transaction_status.0">
        <source>Payment status</source>
      </trans-unit>
