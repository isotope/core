        <source>Shipping status</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.delivery_status.1">
        <source>Select the delivery status of this order.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.delivery_status.2">
        <source>Shipping</source>
        <target>Nakliye</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.locked.0">
        <source>Placed</source>
        <target>Yerleştirilen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.source_collection_id.0">
        <source>Source (Cart ID)</source>
        <target>Kaynak (Sepet ID)</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_paid.0">
        <source>Payment date</source>
        <target>Ödeme tarihi</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_paid.1">
        <source>Enter a date when this order has been paid.</source>
        <target>Bu sipariş ödendiğinde bir tarih girin.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_shipped.0">
        <source>Shipped date</source>
        <target>Nakllye tarihi</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_shipped.1">
        <source>Enter a date when this order has been shipped.</source>
        <target>Bu sipariş gönderildiğinde bir tarih girin.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.sendNotification.0">
        <source>Send a notification</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.sendNotification.1">
        <source>Send an extra notification when saving this record.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification.0">
        <source>Notification</source>
        <target>Bildirim</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification.1">
        <source>Choose a notification that will be sent when saving this record.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_shipping_tracking.0">
        <source>Tracking numbers</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_shipping_tracking.1">
        <source>Here you can enter the shipping tracking information. Use the &lt;em&gt;##order_status_tracking_numbers##&lt;/em&gt; and/or &lt;em&gt;##order_status_tracking_urls##&lt;/em&gt; simple token in the notification.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_customer_notes.0">
        <source>Customer notes</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_customer_notes.1">
        <source>Here you can enter a message to the customer for this status update. Use the &lt;em&gt;##order_status_notes##&lt;/em&gt; simple token in the notification.</source>
      </trans-unit>
