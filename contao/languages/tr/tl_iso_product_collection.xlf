        <source>This order does not have any billing address data.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.shipping_address_legend">
        <source>Shipping address data</source>
        <target>Nakliye Adresi verisi</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.shipping_address_empty">
        <source>This order does not have any shipping address data.</source>
      </trans-unit>
