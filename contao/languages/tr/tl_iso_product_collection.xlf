        <target>Vergisiz ara toplam</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.total.0">
        <source>Total</source>
        <target>Toplam</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.tax_free_total.0">
        <source>Total without tax</source>
        <target>Vergisiz toplam</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.currency.0">
        <source>Currency</source>
        <target>Para birimi</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.language.0">
