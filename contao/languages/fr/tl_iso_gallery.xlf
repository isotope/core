      </trans-unit>
      <trans-unit id="tl_iso_gallery.name_legend">
        <source>Name &amp; Type</source>
        <target>Nom &amp; Type</target>
      </trans-unit>
      <trans-unit id="tl_iso_gallery.size_legend">
        <source>Image sizes</source>
        <target>Tailles des images</target>
      </trans-unit>
      <trans-unit id="tl_iso_gallery.template_legend">
