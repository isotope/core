<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/tl_iso_product.xlf" source-language="en" target-language="sv-SE">
    <body>
      <trans-unit id="tl_iso_product.tableLabel">
        <source>Product</source>
        <target>Produkt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.id.0">
        <source>Product ID</source>
        <target>Produkt ID</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.pages.0">
        <source>Categories</source>
        <target>Kategorier</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.pages.1">
        <source>Select a category (page-based categories take advantage of Contao pages features such as navigation automation, protection, templates, and full integration with content elements.</source>
        <target>Välj en kategori (sidbaserade kategorier drar fördel av Contao-sidornas funktioner som navigationsautomation, skydd, mallar och fullständig integrering med innehållselement.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.type.0">
        <source>Product type</source>
        <target>Produkttyp</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.type.1">
        <source>Select your product type. Product types are defined in the store configuration.</source>
        <target>Välj din produkttyp. Produkttyper definieras i butikskonfigurationen.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.fallback.0">
        <source>Default variant</source>
        <target>Standardvariant</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.fallback.1">
        <source>Click here if this variant should be pre-selected by default.</source>
        <target>Klicka här om denna variant ska vara förvald som standard.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.alias.0">
        <source>Alias</source>
        <target>Alias</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.alias.1">
        <source>You can enter a unique alias for this product. It will be automatically generated from the name if empty.</source>
        <target>Du kan ange ett unikt alias för denna produkt. Det kommer att genereras automatiskt från namnet om det är tomt.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.name.0">
        <source>Name</source>
        <target>Namn</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.name.1">
        <source>Please enter the name of this product.</source>
        <target>Vänligen ange namnet på denna produkt.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.gtin.0">
        <source>GTIN (Global Trade Item Number)</source>
        <target>GTIN (Global Trade Item Number)</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.gtin.1">
        <source>Please enter a unique GTIN (or EAN number).</source>
        <target>Ange ett unikt GTIN (eller EAN-nummer).</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.sku.0">
        <source>SKU</source>
        <target>SKU</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.sku.1">
        <source>Please enter a unique stock keeping unit for this product.</source>
        <target>Ange en unik lagerhållningsenhet för denna produkt.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_weight.0">
        <source>Shipping weight</source>
        <target>Fraktvikt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_weight.1">
        <source>Please enter the shipping weight for this product. This can be used to calculate shipping cost.</source>
        <target>Vänligen ange fraktvikten för denna produkt. Detta kan användas för att beräkna fraktkostnader.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_price.0">
        <source>Shipping price</source>
        <target>Fraktkostnad</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_price.1">
        <source>Please enter the shipping price for this product. This can be used to calculate shipping cost.</source>
        <target>Please enter the shipping price for this product. This can be used to calculate shipping cost.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.teaser.0">
        <source>Teaser</source>
        <target>Teaser</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.teaser.1">
        <source>Please enter the teaser.</source>
        <target>Vänligen ange teasern.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.description.0">
        <source>Description</source>
        <target>Beskrivning</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.description.1">
        <source>Please enter the product description.</source>
        <target>Vänligen ange produktbeskrivningen.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.meta_title.0">
        <source>Meta title</source>
        <target>Meta titel</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.meta_title.1">
        <source>Meta title is used as page title in the product detail view. If you leave it empty, the product name will be used.</source>
        <target>Metatitel används som sidtitel i produktdetaljvyn. Om du lämnar den tom kommer produktnamnet att användas.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.meta_description.0">
        <source>Meta description</source>
        <target>Metabeskrivning</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.meta_description.1">
        <source>Meta description will be placed in the header on product detail page, for search engine optimization.</source>
        <target>Metabeskrivning kommer att placeras i rubriken på produktdetaljsidan, för sökmotoroptimering.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.price.0">
        <source>Price</source>
        <target>Pris</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.price.1">
        <source>Please enter the price(s) for this product and select the tax class.</source>
        <target>Vänligen ange priset (priserna) för denna produkt och välj skatteklass.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_exempt.0">
        <source>Exempt from shipping</source>
        <target>Befriad från frakt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_exempt.1">
        <source>Check if item is not a shipped item (such as downloadable products).</source>
        <target>Kontrollera om varan är en inte skickad vara (som nedladdningsbara produkter).</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_pickup.0">
        <source>Pickup only</source>
        <target>Endast upphämtning</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_pickup.1">
        <source>Check if item can only be picked up (such as fresh or oversized products).</source>
        <target>Kontrollera om varan endast kan hämtas (som färska eller överdimensionerade produkter).</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.baseprice.0">
        <source>Base price amount</source>
        <target>Basprisbelopp</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.baseprice.1">
        <source>Enter the amount to calculate the base price (e.g. &quot;1500&quot; if your product is 1500 grams).</source>
        <target>Ange beloppet för att beräkna baspriset (t.ex. &quot;1500&quot; om din produkt är 1500 gram).</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.images.0">
        <source>Images</source>
        <target>Bilder</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.images.1">
        <source>Upload images to this product. Please save the product after selecting a file.</source>
        <target>Ladda upp bilder till denna produkt. Spara produkten efter att ha valt en fil.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.protected.0">
        <source>Protect product</source>
        <target>Skydda produkten</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.protected.1">
        <source>Show the product to certain member groups only.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.groups.0">
        <source>Allowed member groups</source>
        <target>Tillåtna medlemsgrupper</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.groups.1">
        <source>These groups will be able to see the product.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.cssID.0">
        <source>CSS ID/class</source>
        <target>CSS ID/class</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.cssID.1">
        <source>Here you can set an ID and one or more classes.</source>
        <target>Här kan du ställa in ett ID och en eller flera klasser.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.published.0">
        <source>Publish product</source>
        <target>Publicera produkten</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.published.1">
        <source>Click here to show this product on your website.</source>
        <target>Klicka här för att visa denna produkt på din webbplats.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.start.0">
        <source>Start date</source>
        <target>Start datum</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.start.1">
        <source>Do not show this product before the date specified.</source>
        <target>Visa inte denna produkt före angivet datum.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.stop.0">
        <source>Stop date</source>
        <target>Stoppdatum</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.stop.1">
        <source>Do not show this product after the date specified.</source>
        <target>Visa inte denna produkt efter det angivna datumet.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.inherit.0">
        <source>Inherited attributes</source>
        <target>Ärvda attribut</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.inherit.1">
        <source>Check the fields you want to inherit from base product.</source>
        <target>Markera fälten du vill ärva från basprodukten.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.source.0">
        <source>Source folder</source>
        <target>Källmapp</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.source.1">
        <source>Please choose the folder where product assets are located.</source>
        <target>Vänligen välj mappen där produkttillgångarna finns.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.hitCount.0">
        <source>Hit counter</source>
        <target>Träffräknare</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmSrc">
        <source>Preview</source>
        <target>Förhandsvisning</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmAlt">
        <source>Alternate text</source>
        <target>Alternativ text</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmLink">
        <source>Link target</source>
        <target>Länkmål</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmDesc">
        <source>Description</source>
        <target>Beskrivning</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslate">
        <source>Translate</source>
        <target>Översätt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslateNone.0">
        <source>None</source>
        <target>Ingen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslateNone.1">
        <source>Do not translate this image.</source>
        <target>Do not translate this image.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslateText.0">
        <source>Text</source>
        <target>Text</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslateText.1">
        <source>Translate alt text and description for this image.</source>
        <target>Översätt alternativ text och beskrivning för denna bild.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslateAll.0">
        <source>All</source>
        <target>Allt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.mmTranslateAll.1">
        <source>Do not include this image in translated version.</source>
        <target>Inkludera inte denna bild i översatt version.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.variantValuesLabel">
        <source>Variant</source>
        <target>Variant</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.new.0">
        <source>New product</source>
        <target>Ny produkt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.new.1">
        <source>Create new product</source>
        <target>Skapa ny produkt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.new_variant.0">
        <source>Add variant</source>
        <target>Lägg till variant</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.new_variant.1">
        <source>Add new variant to a given product</source>
        <target>Lägg till en ny variant till en given produkt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.edit.1">
        <source>Edit product ID %s</source>
        <target>Redigera produkt ID %s</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.children.0">
        <source>Edit variants</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.children.1">
        <source>Edit variants of product ID %s</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.filter">
        <source>Dynamic filters</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.filter_noimages">
        <source>Without images</source>
        <target>Utan bilder</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.filter_nocategory">
        <source>Without categories</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.sorting">
        <source>Sort in category</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.0">
        <source>Advanced prices</source>
        <target>Avancerade priser</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.price_tiers.0">
        <source>Price Tiers</source>
        <target>Prisnivåer</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.price_tiers.1">
        <source>Setup at least one price tier for &quot;Quantity 1&quot;. You can enter discount prices if the user orders more than one product.</source>
        <target>Ställ in minst en prisnivå för &quot;Kvantitet 1&quot;. Du kan ange rabatterade priser om användaren beställer mer än en produkt.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.tax_class.0">
        <source>Tax Class</source>
        <target>Skatteklass</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.tax_class.1">
        <source>Please select a tax class for this price.</source>
        <target>Vänligen välj en skatteklass för detta pris.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.rule.0">
        <source>Rule condition</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.rule.1">
        <source>Apply price if this rule matches.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product.prices.apply_and_close">
        <source>Apply and close</source>
        <target>Applicera och stäng</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.related.0">
        <source>Related products</source>
        <target>Relaterade produkter</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.related.1">
        <source>Manage related products for product ID %s</source>
        <target>Hantera relaterade produkter för produkt ID %s</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.general_legend">
        <source>General Settings</source>
        <target>Allmänna Inställningar</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.meta_legend">
        <source>Meta data</source>
        <target>Metadata</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.pricing_legend">
        <source>Pricing Settings</source>
        <target>Prisinställningar</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.inventory_legend">
        <source>Inventory Settings</source>
        <target>Lagerinställningar</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.shipping_legend">
        <source>Shipping Settings</source>
        <target>Fraktinställningar</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.options_legend">
        <source>Product Options Settings</source>
        <target>Inställningar för produktalternativ</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.media_legend">
        <source>Media Management</source>
        <target>Mediehantering</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.expert_legend">
        <source>Expert settings</source>
        <target>Expertinställningar</target>
      </trans-unit>
      <trans-unit id="tl_iso_product.publish_legend">
        <source>Publishing</source>
        <target>Publishing</target>
      </trans-unit>
    </body>
  </file>
