        <target>Bestellinformationen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.transaction_legend">
        <source>Transactions</source>
        <target>Transaktionen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.email_legend">
        <source>Email data</source>
        <target>E-Mail Daten</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.billing_address_legend">
        <source>Billing address data</source>
        <target>Rechnungsadress-Daten</target>
      </trans-unit>
