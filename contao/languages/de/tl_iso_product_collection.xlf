<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/tl_iso_product_collection.xlf" source-language="en" target-language="de">
    <body>
      <trans-unit id="tl_iso_product_collection.tableLabel">
        <source>Order</source>
        <target>Kostenpflichtig bestellen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.recordLabel">
        <source>Order #%s</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.id.0">
        <source>ID</source>
        <target>ID</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.document_number.0">
        <source>Order Number</source>
        <target>Bestellnummer</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.member.0">
        <source>Member (empty for guests)</source>
        <target>Mitglied (Leer für Gäste)</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.uniqid.0">
        <source>Unique ID</source>
        <target>Eindeutige ID</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.order_status.0">
        <source>Order status</source>
        <target>Bestellstatus</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.order_status.1">
        <source>Select the status of this order.</source>
        <target>Wählen Sie den Status der Bestellung.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.transaction_status.0">
        <source>Payment status</source>
        <target>Zahlungsstatus</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.transaction_status.1">
        <source>Select the payment status of this order.</source>
        <target>Wähle den Zahlungsstatus dieser Bestellung.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.transaction_status.2">
        <source>Payment</source>
        <target>Bezahlung</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.delivery_status.0">
        <source>Shipping status</source>
        <target>Versandstatus</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.delivery_status.1">
        <source>Select the delivery status of this order.</source>
        <target>Wähle den Versandstatus dieser Bestellung.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.delivery_status.2">
        <source>Shipping</source>
        <target>Versand</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.locked.0">
        <source>Placed</source>
        <target>Platziert</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.source_collection_id.0">
        <source>Source (Cart ID)</source>
        <target>Quelle (Warenkorb ID)</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_paid.0">
        <source>Payment date</source>
        <target>Bezahldatum</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_paid.1">
        <source>Enter a date when this order has been paid.</source>
        <target>Geben Sie an wann (Datum) diese Bestellung bezahlt wurde.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_shipped.0">
        <source>Shipped date</source>
        <target>Versanddatum</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.date_shipped.1">
        <source>Enter a date when this order has been shipped.</source>
        <target>Geben Sie an wann (Datum) diese Bestellung versandt wurde.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.sendNotification.0">
        <source>Send a notification</source>
        <target>Benachrichtigung senden</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.sendNotification.1">
        <source>Send an extra notification when saving this record.</source>
        <target>Eine zusätzliche Benachrichtigung senden, wenn die Bestellung gespeichert wird.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification.0">
        <source>Notification</source>
        <target>Benachrichtigung</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification.1">
        <source>Choose a notification that will be sent when saving this record.</source>
        <target>Wähle ein Bestellung welche gesendet werden soll, wenn die Bestellung gespeichert wird.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_shipping_tracking.0">
        <source>Tracking numbers</source>
        <target>Sendungsnummern</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_shipping_tracking.1">
        <source>Here you can enter the shipping tracking information. Use the &lt;em&gt;##order_status_tracking_numbers##&lt;/em&gt; and/or &lt;em&gt;##order_status_tracking_urls##&lt;/em&gt; simple token in the notification.</source>
        <target>Hier kannst du Tracking-Nummern des Versanddienstleisters eingeben. Verwende &lt;em&gt;##order_status_tracking_numbers##&lt;/em&gt; und/oder &lt;em&gt;##order_status_tracking_urls##&lt;/em&gt; in der Benachrichtigung..</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_customer_notes.0">
        <source>Customer notes</source>
        <target>Nachricht an den Kunden</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notification_customer_notes.1">
        <source>Here you can enter a message to the customer for this status update. Use the &lt;em&gt;##order_status_notes##&lt;/em&gt; simple token in the notification.</source>
        <target>Hiermit kann eine personalisierter Text gesendet werden. Mit dem Simple Token &lt;em&gt;##order_status_notes##&lt;/em&gt; kannst du dies in der Benachrichtigung ausgeben.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.config_id.0">
        <source>Shop configuration</source>
        <target>Shop-Konfiguration</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.payment_id.0">
        <source>Payment method</source>
        <target>Zahlungsart</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.shipping_id.0">
