        <source>Subtotal without tax</source>
        <target>Zwischensumme ohne Steuern</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.total.0">
        <source>Total</source>
        <target>Gesamt</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.tax_free_total.0">
        <source>Total without tax</source>
        <target>Gesamt ohne Steuern</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.currency.0">
        <source>Currency</source>
        <target>Währung</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.language.0">
        <source>Language</source>
        <target>Sprache</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notes.0">
        <source>Order notes</source>
        <target>Bestellanmerkungen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.notes.1">
        <source>If you would like to convey information to other backend users, please do so here.</source>
        <target>Wenn Sie für andere Backend-Nutzer Informationen hinterlegen möchten, tun Sie das bitte hier.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.details.0">
        <source>Order details</source>
        <target>Bestelldetails</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.details.1">
        <source>Show details of order ID %s</source>
        <target>Details der Bestellung ID %s anzeigen</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.orderStatusUpdate">
        <source>The status of your order has been updated.</source>
        <target>Der Status Ihrer Bestellung wurde aktualisiert.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.orderStatusNotificationSuccess">
        <source>Notifications (e.g. email to client) have been sent. Check the system log if they were delivered successfully.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.orderStatusNotificationError">
        <source>Notifications (e.g. email to client) could not be sent. Check the system log for details.</source>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.noEmailData">
        <source>No additional email data available.</source>
        <target>Keine weiteren E-Mail-Daten vorhanden.</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.updateOrderStatus">
        <source>Update order status</source>
        <target>Bestellstatus aktualisieren</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.noLogData">
        <source>No order logs are available.</source>
        <target>Es sind keine Bestellprotokolle verfügbar.</target>
      </trans-unit>
