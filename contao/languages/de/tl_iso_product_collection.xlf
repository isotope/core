        <target>Versandart</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.billing_address_id.0">
        <source>Billing address</source>
        <target>Rechnungsadresse</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.shipping_address_id.0">
        <source>Shipping address</source>
        <target>Versandadresse</target>
      </trans-unit>
      <trans-unit id="tl_iso_product_collection.subtotal.0">
        <source>Subtotal</source>
        <target>Zwischensumme</target>
      </trans-unit>
