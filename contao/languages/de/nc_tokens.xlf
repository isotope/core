<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/nc_tokens.xlf" source-language="en" target-language="de">
    <body>
      <trans-unit id="nc_tokens.iso_order.uniqid">
        <source>The order&apos;s unique ID.</source>
        <target>Eindeutige ID der Bestellung</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_status">
        <source>The label of the order&apos;s current status.</source>
        <target>Bezeichnung des derzeitigen Status der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_status_*">
        <source>Fields of the current order status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.transaction_status">
        <source>The label of the order&apos;s transaction status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.transaction_status_*">
        <source>Fields of the current transaction status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.delivery_status">
        <source>The label of the order&apos;s delivery status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.delivery_status_*">
        <source>Fields of the current delivery status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.recipient_email">
        <source>The email address of the recipient.</source>
        <target>Die E-Mail-Adresse des Empfängers.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_id">
        <source>The ID of the order.</source>
        <target>Die ID der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_items">
        <source>The number of items (quantities summed up) in the order.</source>
        <target>Die Anzahl der Artikel (Anzahl aufsummiert) in der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_products">
        <source>The number of individual products in the order.</source>
        <target>Die Anzahl von individuellen Produkten in der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_subtotal">
        <source>The order&apos;s subtotal.</source>
        <target>Zwischensumme der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.order_total">
        <source>The order&apos;s total.</source>
        <target>Gesamtsumme der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.document_number">
        <source>The order document number.</source>
        <target>Die Dokumentennummer der Bestellung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.cart_text">
        <source>Order/Cart as text.</source>
        <target>Bestellung/Warenkorb im Text-Format.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.cart_html">
        <source>Order/Cart as HTML.</source>
        <target>Bestellung/Warenkorb in HTML.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.document">
        <source>The document that should be attached (e.g. an invoice).</source>
        <target>Das Dokument, welches angehängt werden soll (z. B. eine Rechnung).</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.bank_name">
        <source>Bank name entered in store config.</source>
        <target>Bankname in der Shop-Konfiguration eingegeben.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.bank_account">
        <source>Bank account number (IBAN) entered in store config.</source>
        <target>Bankkontonummer (z. B. IBAN) in der Shop-Konfiguration eingegeben.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.bank_code">
        <source>Bank code (BIC/SWIFT) entered in store config.</source>
        <target>Bankleitzahl (BIC / SWIFT) in der Shop-Konfiguration eingegeben.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.tax_number">
        <source>Tax number entered in store config.</source>
        <target>Steuernummer in der Shop-Konfiguration eingegeben.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.log_shipping_tracking">
        <source>Shipping tracking entered in order status log.</source>
        <target>Versandverfolgung im Auftragsstatusprotokoll eingetragen.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.log_customer_notes">
        <source>Customer notes entered in order status log.</source>
        <target>Im Auftragsstatusprotokoll eingegebene Kundennotizen.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.collection_*">
        <source>All the collection/order column fields as stored in the database</source>
        <target>Alle Collection/Bestell-Spalten-Felder wie in der Datenbank gespeichert.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.billing_address">
        <source>Formatted billing address.</source>
        <target>Formatierte Rechnungsanschrift</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.billing_address_*">
        <source>All the billing address model fields.</source>
        <target>Alle Rechnungsadresse-Model-Felder.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.shipping_address">
        <source>Formatted shipping address.</source>
        <target>Formatierte Versandanschrift</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.shipping_address_*">
        <source>All the shipping address model fields.</source>
        <target>Alle Versandadresse-Model-Felder.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.form_*">
        <source>All the order condition form fields.</source>
        <target>Alle Bestellbedingungen-Formular-Felder.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.payment_id">
        <source>Payment method ID.</source>
        <target>ID der Zahlungsart.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.payment_label">
        <source>Payment method label.</source>
        <target>Zahlungsart-Beschriftung.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.payment_note">
        <source>Payment method note.</source>
        <target>Notiz zur Zahlungsart.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.shipping_id">
        <source>Shipping method ID.</source>
        <target>ID der Versandart.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.shipping_label">
        <source>Shipping method label.</source>
        <target>Versandart-Name.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.shipping_note">
        <source>Shipping method note.</source>
        <target>Versandart-Hinweis.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.config_*">
        <source>All the store configuration fields.</source>
        <target>Alle Shop-Konfigurations-Felder.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.member_*">
        <source>All the member fields if it was a member checkout.</source>
        <target>Alle Mitglieder-Felder wenn es die Bestellung eines Migliedes war.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.previous_order_status">
        <source>The label of the order&apos;s previous status. Useful for things like &quot;order status changed from x to y&quot;.</source>
        <target>Bezeichnung des vorherigen Bestellstatus. Nützlich beispielsweise für „Bestellstatus änderte sich von x zu y“.</target>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.previous_order_status_*">
        <source>Fields of the previous order status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.previous_transaction_status">
        <source>The label of the previous transaction status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.previous_transaction_status_*">
        <source>Fields of the previous transaction status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.previous_delivery_status">
        <source>The label of the previous delivery status.</source>
      </trans-unit>
      <trans-unit id="nc_tokens.iso_order.previous_delivery_status_*">
        <source>Fields of the previous delivery status.</source>
      </trans-unit>
