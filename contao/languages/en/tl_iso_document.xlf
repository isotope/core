      </trans-unit>
      <trans-unit id="tl_iso_document.collectionTpl.0">
        <source>Collection template</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.collectionTpl.1">
        <source>Choose a collection template you want to render the products with.</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.orderCollectionBy.0">
        <source>Sorting</source>
      </trans-unit>
