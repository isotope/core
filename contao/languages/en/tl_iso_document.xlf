    <body>
      <trans-unit id="tl_iso_document.name.0">
        <source>Document name</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.name.1">
        <source>Enter a name for this document. This will only be used in the backend.</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.type.0">
        <source>Type of document</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.type.1">
        <source>Select a particular document rendering class.</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.logo.0">
        <source>Logo</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.logo.1">
        <source>Select a logo.</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.documentTitle.0">
        <source>Document title</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.documentTitle.1">
        <source>You can use simple tokens ("collection_*" whereas * equals the database column of the collection) to render your file title (e.g. "Invoice title ##collection_document_number##").</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.fileTitle.0">
        <source>File title</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.fileTitle.1">
        <source>You can use simple tokens ("collection_*" whereas * equals the database column of the collection) to render your file title (e.g. "invoice_##collection_document_number##").</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.documentTpl.0">
        <source>Document template</source>
      </trans-unit>
      <trans-unit id="tl_iso_document.documentTpl.1">
