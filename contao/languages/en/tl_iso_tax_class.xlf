<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/tl_iso_tax_class.xlf" source-language="en">
    <body>
      <trans-unit id="tl_iso_tax_class.tableLabel">
        <source>Tax Class</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.name.0">
        <source>Name</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.name.1">
        <source>Give this tax class a name that explains what it is used for.</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.fallback.0">
        <source>Default</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.fallback.1">
        <source>Check here if this is the default tax class.</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.includes.0">
        <source>Tax rate included with product price</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.includes.1">
        <source>Select if prices of products with this tax class contain a tax rate. This tax rate will be subtracted from product price if it does not match.</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.label.0">
        <source>Include label</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.label.1">
        <source>A label for orders to present for subtracted taxes (if included tax does not match). Default tax rate label will be used if this is blank.</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.rates.0">
        <source>Apply tax rates</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.rates.1">
        <source>Add these tax rates to products with this tax class.</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.name_legend">
        <source>Name</source>
      </trans-unit>
      <trans-unit id="tl_iso_tax_class.rate_legend">
        <source>Tax rates</source>
      </trans-unit>
    </body>
  </file>
</xliff>
