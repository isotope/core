<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/cs02/xliff-core-1.2-strict.xsd">
  <file datatype="plaintext" original="contao/languages/en/tl_iso_orderstatus.xlf" source-language="en">
    <body>
      <trans-unit id="tl_iso_orderstatus.tableLabel">
        <source>Order Status</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.type.0">
        <source>Type</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.type.1">
        <source>Select the status type.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.type.order">
        <source>Order status</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.type.transaction">
        <source>Payment status</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.type.delivery">
        <source>Shipping status</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.alias.0">
        <source>Technical name</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.alias.1">
        <source>Please enter a technical name for this status. Use letters and underscores only.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.sorting.0">
        <source>Position</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.sorting.1">
        <source>Enter a numerical value to sort the order status.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.name.0">
        <source>Name</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.name.1">
        <source>Please enter a name for this status.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.label.0">
        <source>Label</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.label.1">
        <source>Optionally enter a front end label for this status.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.workflow.0">
        <source>Next possible states</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.workflow.1">
        <source>Select the next status options and order can receive when having this status.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.color.0">
        <source>Color</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.color.1">
        <source>Here you can set a custom color for this status. The color will appear on the order list in back end.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state.0">
        <source>Payment state</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state.1">
        <source>Configure the payment state for orders with this status.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state_options.pending.0">
        <source>Pending</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state_options.pending.1">
        <source>If the transaction status is pending, it means the payment has not been attempted or should be attempted again. The user will be requested to complete the payment for the order.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state_options.processing.0">
        <source>Processing</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state_options.processing.1">
        <source>If the transaction status is processing, it means the payment is neither success nor failure. In this state, the user cannot change the order, but the order is also not considers done (e.g. downloads should not be available).</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state_options.complete.0">
        <source>Complete</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.transaction_state_options.complete.1">
        <source>If the transaction is complete, the payment was successful. Shipping can be initiated and downloads should be available at this stage.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.welcomescreen.0">
        <source>Show on welcome screen</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.welcomescreen.1">
        <source>Show number of orders with this status on the backend welcome screen.</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.name_legend">
        <source>Name</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.order_legend">
        <source>Order state</source>
      </trans-unit>
      <trans-unit id="tl_iso_orderstatus.workflow_legend">
        <source>Workflow</source>
      </trans-unit>
    </body>
  </file>
</xliff>
