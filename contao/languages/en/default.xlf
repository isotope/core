      <trans-unit id="MSC.iso_taxCalculation.vertical.0">
        <source>vertical</source>
      </trans-unit>
      <trans-unit id="MSC.iso_taxCalculation.vertical.1">
        <source>VAT is calculated only after summing all net amounts. Then the tax is applied to the total net amount and rounded once.</source>
      </trans-unit>
